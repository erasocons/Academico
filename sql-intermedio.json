{"version":3,"kind":"Notebook","sha256":"4f832a9fc541e20fc47cfb614b788a57a2e20af47523cb8032f7447dc0b521f0","slug":"sql-intermedio","location":"/content/SQL_intermedio.ipynb","dependencies":[],"frontmatter":{"title":"SQL Intermedio: Agregaciones, Joins y Subconsultas","content_includes_title":false,"authors":[{"id":"Diego Eraso","name":"Diego Eraso"}],"keywords":["data-analytics","python","jupyter"],"numbering":{"title":{"offset":2}},"exports":[{"format":"ipynb","filename":"SQL_intermedio.ipynb","url":"/Academico//build/SQL_intermedio-3bc7f54e96889991969ac4278a1bf4ca.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"En este cuaderno exploraremos conceptos intermedios de SQL utilizando Python y la librería ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Aw3PS9ONjV"},{"type":"inlineCode","value":"sqlite3","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fBHCzAKyh5"},{"type":"text","value":" junto con ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XDusIl4sg8"},{"type":"inlineCode","value":"pandas","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"CH9YMUEmec"},{"type":"text","value":" para visualizar los resultados.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pkXY5W0oWd"}],"key":"fySeA4c3sR"}],"identifier":"c34336cf","html_id":"c34336cf","key":"LOmiJF24Fu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import sqlite3\nimport pandas as pd\n\n# Crear una base de datos en memoria para el ejemplo\nconn = sqlite3.connect(':memory:')\ncursor = conn.cursor()\n\n# Crear tablas de ejemplo: empleados y departamentos\ncursor.execute('''\nCREATE TABLE departamentos (\n    id INTEGER PRIMARY KEY,\n    nombre TEXT\n);\n''')\n\ncursor.execute('''\nCREATE TABLE empleados (\n    id INTEGER PRIMARY KEY,\n    nombre TEXT,\n    departamento_id INTEGER,\n    salario REAL,\n    FOREIGN KEY (departamento_id) REFERENCES departamentos (id)\n);\n''')\n\n# Insertar datos\ncursor.executemany('INSERT INTO departamentos VALUES (?, ?)', [\n    (1, 'Ventas'),\n    (2, 'IT'),\n    (3, 'Recursos Humanos'),\n    (4, 'Marketing')\n])\n\ncursor.executemany('INSERT INTO empleados VALUES (?, ?, ?, ?)', [\n    (1, 'Ana', 1, 3000),\n    (2, 'Luis', 1, 3500),\n    (3, 'Carlos', 2, 5000),\n    (4, 'Sofia', 2, 6000),\n    (5, 'Marta', 3, 2500),\n    (6, 'Pedro', None, 2000)\n])\n\nconn.commit()","key":"x1ea3LZ594"},{"type":"outputs","id":"sT-sp7gmSWbASbElDrSCV","children":[],"key":"hBbiwt9Srd"}],"identifier":"7c726f22","html_id":"7c726f22","key":"wNwxUJNCDw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"09. Funciones de Agregación (Aggregate Functions)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UNZHLuGxsE"}],"identifier":"id-09-funciones-de-agregaci-n-aggregate-functions","label":"09. Funciones de Agregación (Aggregate Functions)","html_id":"id-09-funciones-de-agregaci-n-aggregate-functions","implicit":true,"key":"YVP9lecyE4"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Las funciones de agregación realizan un cálculo sobre un conjunto de valores y devuelven un solo valor (COUNT, SUM, AVG, MAX, MIN).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"djCSqQjiQl"}],"key":"smPscneX6H"}],"identifier":"94f3a7c4","html_id":"94f3a7c4","key":"qJYNtN1rr3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    COUNT(*) AS total_empleados,\n    SUM(salario) AS salario_total,\n    AVG(salario) AS salario_promedio,\n    MAX(salario) AS salario_maximo,\n    MIN(salario) AS salario_minimo\nFROM empleados;\n'''\npd.read_sql_query(query, conn)","key":"gKoVN6cmk6"},{"type":"outputs","id":"JGxvhBZ8kDChp6HvIxuw4","children":[],"key":"dyfeZTrcPf"}],"identifier":"c59d7965","html_id":"c59d7965","key":"VyOnUVNIMj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"10. GROUP BY","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ccIisIt2NQ"}],"identifier":"id-10-group-by","label":"10. GROUP BY","html_id":"id-10-group-by","implicit":true,"key":"WpLg9Fb5iG"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Permite agrupar filas que comparten un mismo valor en columnas específicas para aplicar funciones de agregación a cada grupo.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"G9J2Gk2gVJ"}],"key":"b8WBcR2JfB"}],"identifier":"f71a8222","html_id":"f71a8222","key":"fTugNS50zw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    departamento_id,\n    COUNT(*) AS num_empleados,\n    AVG(salario) AS salario_promedio\nFROM empleados\nGROUP BY departamento_id;\n'''\npd.read_sql_query(query, conn)","key":"w1kBqCtmeA"},{"type":"outputs","id":"sNBUbvrhOKTB1wD7mdt_X","children":[],"key":"OFIgGydSPP"}],"identifier":"7388a890","html_id":"7388a890","key":"iwKbSEoXqZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"11. HAVING","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vznVQVqBVu"}],"identifier":"id-11-having","label":"11. HAVING","html_id":"id-11-having","implicit":true,"key":"LGO2D2NrC0"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Se utiliza para filtrar los resultados agrupados (similar a WHERE, pero operando sobre funciones de agregación).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"hhB0n8lLYv"}],"key":"JUXeNk1m7z"}],"identifier":"1d2daa40","html_id":"1d2daa40","key":"g3FUTvgi6A"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    departamento_id,\n    AVG(salario) AS salario_promedio\nFROM empleados\nGROUP BY departamento_id\nHAVING AVG(salario) > 3000;\n'''\npd.read_sql_query(query, conn)","key":"eJL7bat7t9"},{"type":"outputs","id":"TdaH0ppOLL66LoJH9Msw0","children":[],"key":"SsKOafEstK"}],"identifier":"3579e56e","html_id":"3579e56e","key":"sKDRTXNRm5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"12. INNER JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"D6TRzG4MZn"}],"identifier":"id-12-inner-join","label":"12. INNER JOIN","html_id":"id-12-inner-join","implicit":true,"key":"ROZexViwgb"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Devuelve registros que tienen valores coincidentes en ambas tablas.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"BpCUBDfPYB"}],"key":"ZzfEcwSexa"}],"identifier":"6578a505","html_id":"6578a505","key":"IJJRuQwJSx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    e.nombre AS empleado,\n    d.nombre AS departamento\nFROM empleados e\nINNER JOIN departamentos d \n    ON e.departamento_id = d.id;\n'''\npd.read_sql_query(query, conn)","key":"TPDJeugmEU"},{"type":"outputs","id":"rr0w7ujxJGL6oVa14HIaY","children":[],"key":"CEJ0kpwsYZ"}],"identifier":"3b8f0233","html_id":"3b8f0233","key":"i2hNUw4jsY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"13. LEFT JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wGx7DD3DiI"}],"identifier":"id-13-left-join","label":"13. LEFT JOIN","html_id":"id-13-left-join","implicit":true,"key":"x372ofX9DP"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Devuelve todos los registros de la tabla izquierda, y los registros coincidentes de la tabla derecha.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"vX2G75u5Xw"}],"key":"U7gpb2HLdq"}],"identifier":"cf5907cc","html_id":"cf5907cc","key":"rzt50vI5jA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    e.nombre AS empleado,\n    d.nombre AS departamento\nFROM empleados e\nLEFT JOIN departamentos d \n    ON e.departamento_id = d.id;\n'''\npd.read_sql_query(query, conn)","key":"XlhTS7xNFP"},{"type":"outputs","id":"Cmu2NsuQXJ1UXGwXRomGQ","children":[],"key":"qMpt2yYhde"}],"identifier":"38f8aa2d","html_id":"38f8aa2d","key":"YGMxuka5Pf"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"14. RIGHT JOIN y FULL JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mV91zjtooC"}],"identifier":"id-14-right-join-y-full-join","label":"14. RIGHT JOIN y FULL JOIN","html_id":"id-14-right-join-y-full-join","implicit":true,"key":"NOPkSGhuC7"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Nota: SQLite no soporta directamente RIGHT JOIN ni FULL OUTER JOIN, pero se pueden emular con UNION o invirtiendo las tablas en un LEFT JOIN.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"lAcudb4XQq"}],"key":"JNb5SL2PtN"}],"identifier":"66da9f5f","html_id":"66da9f5f","key":"RGA6UscMk7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Emulando RIGHT JOIN invirtiendo la lógica con LEFT JOIN\nquery = '''\nSELECT \n    e.nombre AS empleado,\n    d.nombre AS departamento\nFROM departamentos d\nLEFT JOIN empleados e \n    ON e.departamento_id = d.id;\n'''\npd.read_sql_query(query, conn)","key":"U4qANCfWol"},{"type":"outputs","id":"2Y-JfwfxNgDN0NkNGXSug","children":[],"key":"gzpcaPd5Ek"}],"identifier":"89d4ff99","html_id":"89d4ff99","key":"lqD4bWDGMj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"15. SELF JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ppmPWquleh"}],"identifier":"id-15-self-join","label":"15. SELF JOIN","html_id":"id-15-self-join","implicit":true,"key":"N7QOKG5g3z"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Es una unión regular donde una tabla se une a sí misma.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"irbDZUF9F3"}],"key":"AINnFdpvh6"}],"identifier":"4e904b88","html_id":"4e904b88","key":"o8B1p7zs68"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Ejemplo teórico creando una relación de compañeros en el mismo departamento\nquery = '''\nSELECT \n    e1.nombre AS empleado1,\n    e2.nombre AS empleado2,\n    e1.departamento_id\nFROM empleados e1\nJOIN empleados e2 \n    ON e1.departamento_id = e2.departamento_id \n    AND e1.id < e2.id;\n'''\npd.read_sql_query(query, conn)","key":"b77VEMpoif"},{"type":"outputs","id":"bywwwTOVsfyRotiNyAJA-","children":[],"key":"fNgvgj1mc4"}],"identifier":"81046ca6","html_id":"81046ca6","key":"G04Tp5kN2O"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"16. Subconsultas (Subqueries)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cKEjzmDajM"}],"identifier":"id-16-subconsultas-subqueries","label":"16. Subconsultas (Subqueries)","html_id":"id-16-subconsultas-subqueries","implicit":true,"key":"LzuhpUBk2b"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Una consulta dentro de otra consulta.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"san6YEBCLk"}],"key":"RLf4EFJnbT"}],"identifier":"d85997b9","html_id":"d85997b9","key":"f9rOyVVx8r"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT nombre, salario\nFROM empleados\nWHERE salario > (\n    SELECT AVG(salario) FROM empleados\n);\n'''\npd.read_sql_query(query, conn)","key":"JMLRejPvnO"},{"type":"outputs","id":"-FB1ekUTjDlWjC91XNuIX","children":[],"key":"ahiUG6ocT0"}],"identifier":"d60aedf6","html_id":"d60aedf6","key":"pnwjkUNPmG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"17. CTEs (Common Table Expressions)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"To89LpUlpa"}],"identifier":"id-17-ctes-common-table-expressions","label":"17. CTEs (Common Table Expressions)","html_id":"id-17-ctes-common-table-expressions","implicit":true,"key":"YwXaIPLVcO"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Las CTEs proporcionan un conjunto de resultados temporal con nombre que se puede referenciar dentro de una sentencia SELECT, INSERT, UPDATE o DELETE.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"aQzx5VXIwT"}],"key":"xiliLWXhpn"}],"identifier":"8802a0c5","html_id":"8802a0c5","key":"Aq7mz2DaZy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nWITH PromedioSalarios AS (\n    SELECT departamento_id, AVG(salario) as promedio\n    FROM empleados\n    GROUP BY departamento_id\n)\nSELECT \n    e.nombre,\n    e.salario,\n    p.promedio\nFROM empleados e\nJOIN PromedioSalarios p \n    ON e.departamento_id = p.departamento_id\nWHERE e.salario > p.promedio;\n'''\npd.read_sql_query(query, conn)","key":"voG1BSo41p"},{"type":"outputs","id":"J0N371kuOqcF_8vSumbQG","children":[],"key":"rY2uHIn7Yi"}],"identifier":"f595c74d","html_id":"f595c74d","key":"PT2WjpCWMu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Cerrar la conexión\nconn.close()","key":"LyXKw9Cvl9"},{"type":"outputs","id":"ZrUwEIPGKfGWjOusDsfL7","children":[],"key":"oWt9CaotNw"}],"identifier":"fb5aee38","html_id":"fb5aee38","key":"uPM6OAwFwT"}],"key":"r8tRXwoxKe"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Introducción a SQL","url":"/sql-basico","group":"Módulo 1 - FUNDAMENTOS"},"next":{"title":"SQL Avanzado: Análisis de Datos y Window Functions","url":"/sql-avanzado","group":"Módulo 1 - FUNDAMENTOS"}}},"domain":"http://localhost:3000"}