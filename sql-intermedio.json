{"version":3,"kind":"Notebook","sha256":"4f832a9fc541e20fc47cfb614b788a57a2e20af47523cb8032f7447dc0b521f0","slug":"sql-intermedio","location":"/content/SQL_intermedio.ipynb","dependencies":[],"frontmatter":{"title":"SQL Intermedio: Agregaciones, Joins y Subconsultas","content_includes_title":false,"authors":[{"id":"Diego Eraso","name":"Diego Eraso"}],"keywords":["data-analytics","python","jupyter"],"numbering":{"title":{"offset":2}},"exports":[{"format":"ipynb","filename":"SQL_intermedio.ipynb","url":"/Academico/_public/SQL_intermedio-296712c44dd864c346c54ed6377ff93b.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"En este cuaderno exploraremos conceptos intermedios de SQL utilizando Python y la librería ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"w2qUqGtPoc"},{"type":"inlineCode","value":"sqlite3","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Jzzqf9sX3o"},{"type":"text","value":" junto con ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SKjnnKjEsm"},{"type":"inlineCode","value":"pandas","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TTmwG32ZdC"},{"type":"text","value":" para visualizar los resultados.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GQ2cl894QR"}],"key":"U9exVk6elC"}],"identifier":"c34336cf","html_id":"c34336cf","key":"J8oBuyMlMS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import sqlite3\nimport pandas as pd\n\n# Crear una base de datos en memoria para el ejemplo\nconn = sqlite3.connect(':memory:')\ncursor = conn.cursor()\n\n# Crear tablas de ejemplo: empleados y departamentos\ncursor.execute('''\nCREATE TABLE departamentos (\n    id INTEGER PRIMARY KEY,\n    nombre TEXT\n);\n''')\n\ncursor.execute('''\nCREATE TABLE empleados (\n    id INTEGER PRIMARY KEY,\n    nombre TEXT,\n    departamento_id INTEGER,\n    salario REAL,\n    FOREIGN KEY (departamento_id) REFERENCES departamentos (id)\n);\n''')\n\n# Insertar datos\ncursor.executemany('INSERT INTO departamentos VALUES (?, ?)', [\n    (1, 'Ventas'),\n    (2, 'IT'),\n    (3, 'Recursos Humanos'),\n    (4, 'Marketing')\n])\n\ncursor.executemany('INSERT INTO empleados VALUES (?, ?, ?, ?)', [\n    (1, 'Ana', 1, 3000),\n    (2, 'Luis', 1, 3500),\n    (3, 'Carlos', 2, 5000),\n    (4, 'Sofia', 2, 6000),\n    (5, 'Marta', 3, 2500),\n    (6, 'Pedro', None, 2000)\n])\n\nconn.commit()","key":"npokSIRNDw"},{"type":"outputs","id":"iTa-5MFyMX-AGroqQd5jg","children":[],"key":"lo4CtM3JPX"}],"identifier":"7c726f22","html_id":"7c726f22","key":"BdepKqitrh"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"09. Funciones de Agregación (Aggregate Functions)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EbvY6VB0Zz"}],"identifier":"id-09-funciones-de-agregaci-n-aggregate-functions","label":"09. Funciones de Agregación (Aggregate Functions)","html_id":"id-09-funciones-de-agregaci-n-aggregate-functions","implicit":true,"key":"TkUhLVuOCc"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Las funciones de agregación realizan un cálculo sobre un conjunto de valores y devuelven un solo valor (COUNT, SUM, AVG, MAX, MIN).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ocrpga2ckR"}],"key":"I6xrghfE5G"}],"identifier":"94f3a7c4","html_id":"94f3a7c4","key":"CzJmhLfzqr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    COUNT(*) AS total_empleados,\n    SUM(salario) AS salario_total,\n    AVG(salario) AS salario_promedio,\n    MAX(salario) AS salario_maximo,\n    MIN(salario) AS salario_minimo\nFROM empleados;\n'''\npd.read_sql_query(query, conn)","key":"CtOrg5tfcT"},{"type":"outputs","id":"_hIsX-rT3b9Y2TYUuSZg4","children":[],"key":"D3YQBZ9al4"}],"identifier":"c59d7965","html_id":"c59d7965","key":"eBGFhdNvfV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"10. GROUP BY","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EyFxsNkDD1"}],"identifier":"id-10-group-by","label":"10. GROUP BY","html_id":"id-10-group-by","implicit":true,"key":"f4bAwCzxUC"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Permite agrupar filas que comparten un mismo valor en columnas específicas para aplicar funciones de agregación a cada grupo.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ANiojQHXMW"}],"key":"mfqIBkTcTk"}],"identifier":"f71a8222","html_id":"f71a8222","key":"J0ZAJ0K9Ar"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    departamento_id,\n    COUNT(*) AS num_empleados,\n    AVG(salario) AS salario_promedio\nFROM empleados\nGROUP BY departamento_id;\n'''\npd.read_sql_query(query, conn)","key":"G9j0J6zCNH"},{"type":"outputs","id":"l35pignCV-HSC2ecD7IfX","children":[],"key":"m1SDv7J8nc"}],"identifier":"7388a890","html_id":"7388a890","key":"IHR5fYsrvi"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"11. HAVING","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ATijLzC5XQ"}],"identifier":"id-11-having","label":"11. HAVING","html_id":"id-11-having","implicit":true,"key":"ToNAnLTr0f"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Se utiliza para filtrar los resultados agrupados (similar a WHERE, pero operando sobre funciones de agregación).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Z8zOTFVEmU"}],"key":"dn0gsO0U0R"}],"identifier":"1d2daa40","html_id":"1d2daa40","key":"bDljRYaUWO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    departamento_id,\n    AVG(salario) AS salario_promedio\nFROM empleados\nGROUP BY departamento_id\nHAVING AVG(salario) > 3000;\n'''\npd.read_sql_query(query, conn)","key":"roJ5dDCucT"},{"type":"outputs","id":"v6jczXmn1BMUZs6lT13fU","children":[],"key":"Z3tRXhH0Rk"}],"identifier":"3579e56e","html_id":"3579e56e","key":"qsCK1FbyIW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"12. INNER JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"V4dpyUCLRE"}],"identifier":"id-12-inner-join","label":"12. INNER JOIN","html_id":"id-12-inner-join","implicit":true,"key":"B3fn4v0GeS"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Devuelve registros que tienen valores coincidentes en ambas tablas.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"zl8rp1jT9n"}],"key":"TeDVOW6bzL"}],"identifier":"6578a505","html_id":"6578a505","key":"P9MZMSPalX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    e.nombre AS empleado,\n    d.nombre AS departamento\nFROM empleados e\nINNER JOIN departamentos d \n    ON e.departamento_id = d.id;\n'''\npd.read_sql_query(query, conn)","key":"PVlS6dAhdx"},{"type":"outputs","id":"i-7a2nOdDQi7NcRoQ0ccX","children":[],"key":"cj2M8NKKc3"}],"identifier":"3b8f0233","html_id":"3b8f0233","key":"OLuABC4VFG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"13. LEFT JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hxJ169se4d"}],"identifier":"id-13-left-join","label":"13. LEFT JOIN","html_id":"id-13-left-join","implicit":true,"key":"YabMbEaGqw"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Devuelve todos los registros de la tabla izquierda, y los registros coincidentes de la tabla derecha.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"CJjfmZhflS"}],"key":"L9pAC0XPt0"}],"identifier":"cf5907cc","html_id":"cf5907cc","key":"G5NVdJ0jpL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    e.nombre AS empleado,\n    d.nombre AS departamento\nFROM empleados e\nLEFT JOIN departamentos d \n    ON e.departamento_id = d.id;\n'''\npd.read_sql_query(query, conn)","key":"XTxuT6R0k0"},{"type":"outputs","id":"R5ir_G22UXpQ3s1gF3Gy4","children":[],"key":"Ca4JdxJHE9"}],"identifier":"38f8aa2d","html_id":"38f8aa2d","key":"ny4tp1sryL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"14. RIGHT JOIN y FULL JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"idkhPaOmMq"}],"identifier":"id-14-right-join-y-full-join","label":"14. RIGHT JOIN y FULL JOIN","html_id":"id-14-right-join-y-full-join","implicit":true,"key":"qd23p8r8ld"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Nota: SQLite no soporta directamente RIGHT JOIN ni FULL OUTER JOIN, pero se pueden emular con UNION o invirtiendo las tablas en un LEFT JOIN.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"WQ4jAzRJpM"}],"key":"OmJiH5vw5f"}],"identifier":"66da9f5f","html_id":"66da9f5f","key":"U4d8BiwTMc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Emulando RIGHT JOIN invirtiendo la lógica con LEFT JOIN\nquery = '''\nSELECT \n    e.nombre AS empleado,\n    d.nombre AS departamento\nFROM departamentos d\nLEFT JOIN empleados e \n    ON e.departamento_id = d.id;\n'''\npd.read_sql_query(query, conn)","key":"iqmO0FcCD0"},{"type":"outputs","id":"7JnLWi7IS7Xjs_Fi1Fsj1","children":[],"key":"EG3AUUmCL0"}],"identifier":"89d4ff99","html_id":"89d4ff99","key":"UVduuh7duI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"15. SELF JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"O7QSgVuqJF"}],"identifier":"id-15-self-join","label":"15. SELF JOIN","html_id":"id-15-self-join","implicit":true,"key":"oaULPpD7mC"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Es una unión regular donde una tabla se une a sí misma.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"AKDcxTzyqu"}],"key":"qlae8R5QV5"}],"identifier":"4e904b88","html_id":"4e904b88","key":"irWcLTwWLY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Ejemplo teórico creando una relación de compañeros en el mismo departamento\nquery = '''\nSELECT \n    e1.nombre AS empleado1,\n    e2.nombre AS empleado2,\n    e1.departamento_id\nFROM empleados e1\nJOIN empleados e2 \n    ON e1.departamento_id = e2.departamento_id \n    AND e1.id < e2.id;\n'''\npd.read_sql_query(query, conn)","key":"FCC0x3pANu"},{"type":"outputs","id":"SFkU49a8MsOEjkvYEXDyL","children":[],"key":"GfhleC1bz8"}],"identifier":"81046ca6","html_id":"81046ca6","key":"ZW2b1AtbYP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"16. Subconsultas (Subqueries)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CyfOjHTCI2"}],"identifier":"id-16-subconsultas-subqueries","label":"16. Subconsultas (Subqueries)","html_id":"id-16-subconsultas-subqueries","implicit":true,"key":"P2i9etKLmx"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Una consulta dentro de otra consulta.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"nkmhQMaFon"}],"key":"x8k2chQ0dJ"}],"identifier":"d85997b9","html_id":"d85997b9","key":"EsQcebpCf4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT nombre, salario\nFROM empleados\nWHERE salario > (\n    SELECT AVG(salario) FROM empleados\n);\n'''\npd.read_sql_query(query, conn)","key":"zdU8ECFNgh"},{"type":"outputs","id":"392Mn2JPHMuB77LXRA1N0","children":[],"key":"H45wnh3Q9F"}],"identifier":"d60aedf6","html_id":"d60aedf6","key":"ZviszHfzAM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"17. CTEs (Common Table Expressions)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WNnoAdUaju"}],"identifier":"id-17-ctes-common-table-expressions","label":"17. CTEs (Common Table Expressions)","html_id":"id-17-ctes-common-table-expressions","implicit":true,"key":"lnV7N1WqWy"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Las CTEs proporcionan un conjunto de resultados temporal con nombre que se puede referenciar dentro de una sentencia SELECT, INSERT, UPDATE o DELETE.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"QNx9cGBWIK"}],"key":"ljq5qoCFgm"}],"identifier":"8802a0c5","html_id":"8802a0c5","key":"kpjwg4rI2e"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nWITH PromedioSalarios AS (\n    SELECT departamento_id, AVG(salario) as promedio\n    FROM empleados\n    GROUP BY departamento_id\n)\nSELECT \n    e.nombre,\n    e.salario,\n    p.promedio\nFROM empleados e\nJOIN PromedioSalarios p \n    ON e.departamento_id = p.departamento_id\nWHERE e.salario > p.promedio;\n'''\npd.read_sql_query(query, conn)","key":"yBUM2XnIO4"},{"type":"outputs","id":"v-8xT2eeUCoyRIza3Txak","children":[],"key":"f3olpLtDk1"}],"identifier":"f595c74d","html_id":"f595c74d","key":"MALJq9jMbc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Cerrar la conexión\nconn.close()","key":"uuKN6EhQyb"},{"type":"outputs","id":"ikn2hJ30GbOxpLic6d8Ck","children":[],"key":"IbzT1UMXor"}],"identifier":"fb5aee38","html_id":"fb5aee38","key":"nWGhOSSsvo"}],"key":"OdavRExFa5"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Introducción a SQL","url":"/sql-basico","group":"Módulo 1 - FUNDAMENTOS"},"next":{"title":"SQL Avanzado: Análisis de Datos y Window Functions","url":"/sql-avanzado","group":"Módulo 1 - FUNDAMENTOS"}}},"domain":"http://pre.render"}