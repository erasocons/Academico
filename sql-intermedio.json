{"version":3,"kind":"Notebook","sha256":"4f832a9fc541e20fc47cfb614b788a57a2e20af47523cb8032f7447dc0b521f0","slug":"sql-intermedio","location":"/content/SQL_intermedio.ipynb","dependencies":[],"frontmatter":{"title":"SQL Intermedio: Agregaciones, Joins y Subconsultas","content_includes_title":false,"authors":[{"id":"Diego Eraso","name":"Diego Eraso"}],"keywords":["data-analytics","python","jupyter"],"numbering":{"title":{"offset":2}},"exports":[{"format":"ipynb","filename":"SQL_intermedio.ipynb","url":"/Academico//build/SQL_intermedio-f2a9bd113d26b7cb4ae65f76c01786c9.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"En este cuaderno exploraremos conceptos intermedios de SQL utilizando Python y la librería ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"R4F30osOb1"},{"type":"inlineCode","value":"sqlite3","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iFC8iqjQtl"},{"type":"text","value":" junto con ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bYNsKfRGa1"},{"type":"inlineCode","value":"pandas","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jUVArVXYyk"},{"type":"text","value":" para visualizar los resultados.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QGgcysQQcG"}],"key":"sQcdhPBxxL"}],"identifier":"c34336cf","html_id":"c34336cf","key":"duQrXhqXl9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import sqlite3\nimport pandas as pd\n\n# Crear una base de datos en memoria para el ejemplo\nconn = sqlite3.connect(':memory:')\ncursor = conn.cursor()\n\n# Crear tablas de ejemplo: empleados y departamentos\ncursor.execute('''\nCREATE TABLE departamentos (\n    id INTEGER PRIMARY KEY,\n    nombre TEXT\n);\n''')\n\ncursor.execute('''\nCREATE TABLE empleados (\n    id INTEGER PRIMARY KEY,\n    nombre TEXT,\n    departamento_id INTEGER,\n    salario REAL,\n    FOREIGN KEY (departamento_id) REFERENCES departamentos (id)\n);\n''')\n\n# Insertar datos\ncursor.executemany('INSERT INTO departamentos VALUES (?, ?)', [\n    (1, 'Ventas'),\n    (2, 'IT'),\n    (3, 'Recursos Humanos'),\n    (4, 'Marketing')\n])\n\ncursor.executemany('INSERT INTO empleados VALUES (?, ?, ?, ?)', [\n    (1, 'Ana', 1, 3000),\n    (2, 'Luis', 1, 3500),\n    (3, 'Carlos', 2, 5000),\n    (4, 'Sofia', 2, 6000),\n    (5, 'Marta', 3, 2500),\n    (6, 'Pedro', None, 2000)\n])\n\nconn.commit()","key":"ICnx7z9AKf"},{"type":"outputs","id":"LW9R220DMrYtPMXzTq1Vw","children":[],"key":"zJkeEUiIhc"}],"identifier":"7c726f22","html_id":"7c726f22","key":"mLyFv1klcd"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"09. Funciones de Agregación (Aggregate Functions)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rM3hLwRC98"}],"identifier":"id-09-funciones-de-agregaci-n-aggregate-functions","label":"09. Funciones de Agregación (Aggregate Functions)","html_id":"id-09-funciones-de-agregaci-n-aggregate-functions","implicit":true,"key":"Vwv6pX9Z9N"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Las funciones de agregación realizan un cálculo sobre un conjunto de valores y devuelven un solo valor (COUNT, SUM, AVG, MAX, MIN).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"CKaYVnuAfo"}],"key":"wG2FG5UUoA"}],"identifier":"94f3a7c4","html_id":"94f3a7c4","key":"XTHKgSbD3U"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    COUNT(*) AS total_empleados,\n    SUM(salario) AS salario_total,\n    AVG(salario) AS salario_promedio,\n    MAX(salario) AS salario_maximo,\n    MIN(salario) AS salario_minimo\nFROM empleados;\n'''\npd.read_sql_query(query, conn)","key":"lPm5PGl4fX"},{"type":"outputs","id":"Kv4f3u1X0cgWAkYhcZDEF","children":[],"key":"FNe42hwcy0"}],"identifier":"c59d7965","html_id":"c59d7965","key":"IOhGViEOPJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"10. GROUP BY","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Iky44NxPxc"}],"identifier":"id-10-group-by","label":"10. GROUP BY","html_id":"id-10-group-by","implicit":true,"key":"dRBby9avfQ"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Permite agrupar filas que comparten un mismo valor en columnas específicas para aplicar funciones de agregación a cada grupo.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"riaqfraDm4"}],"key":"ppKF9FCgIR"}],"identifier":"f71a8222","html_id":"f71a8222","key":"uQFXtaDaAo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    departamento_id,\n    COUNT(*) AS num_empleados,\n    AVG(salario) AS salario_promedio\nFROM empleados\nGROUP BY departamento_id;\n'''\npd.read_sql_query(query, conn)","key":"qYRcx7F5xy"},{"type":"outputs","id":"0NqXRSmP_35xZ5Uy8NS03","children":[],"key":"mCzaIVfIlc"}],"identifier":"7388a890","html_id":"7388a890","key":"bIHyBfmC1n"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"11. HAVING","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sE3XZB6YgZ"}],"identifier":"id-11-having","label":"11. HAVING","html_id":"id-11-having","implicit":true,"key":"Me5LSzlC8n"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Se utiliza para filtrar los resultados agrupados (similar a WHERE, pero operando sobre funciones de agregación).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"gh4UUPxKVO"}],"key":"AP8NN8Bt5f"}],"identifier":"1d2daa40","html_id":"1d2daa40","key":"pL3oScdzXV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    departamento_id,\n    AVG(salario) AS salario_promedio\nFROM empleados\nGROUP BY departamento_id\nHAVING AVG(salario) > 3000;\n'''\npd.read_sql_query(query, conn)","key":"ZSLsbY0Pj1"},{"type":"outputs","id":"Gp66vS8SxRVc0_VsuWx9v","children":[],"key":"XGRof8oK9E"}],"identifier":"3579e56e","html_id":"3579e56e","key":"g347dTFBH0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"12. INNER JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"A1b5y5TrGv"}],"identifier":"id-12-inner-join","label":"12. INNER JOIN","html_id":"id-12-inner-join","implicit":true,"key":"LTjLjldhS4"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Devuelve registros que tienen valores coincidentes en ambas tablas.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"DA2WWspf42"}],"key":"qnucgNTscM"}],"identifier":"6578a505","html_id":"6578a505","key":"WsVLvvp33j"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    e.nombre AS empleado,\n    d.nombre AS departamento\nFROM empleados e\nINNER JOIN departamentos d \n    ON e.departamento_id = d.id;\n'''\npd.read_sql_query(query, conn)","key":"PtSY5TSIsU"},{"type":"outputs","id":"3ZiFbZeoHxpQZW5I5Xkpv","children":[],"key":"lO96z9dWbs"}],"identifier":"3b8f0233","html_id":"3b8f0233","key":"sy27l4hgmc"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"13. LEFT JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ADZC2fYPqv"}],"identifier":"id-13-left-join","label":"13. LEFT JOIN","html_id":"id-13-left-join","implicit":true,"key":"WnWCwNJrlY"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Devuelve todos los registros de la tabla izquierda, y los registros coincidentes de la tabla derecha.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"o1TsynLPaA"}],"key":"EI1NZYG3mI"}],"identifier":"cf5907cc","html_id":"cf5907cc","key":"bNR2mG2hcc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    e.nombre AS empleado,\n    d.nombre AS departamento\nFROM empleados e\nLEFT JOIN departamentos d \n    ON e.departamento_id = d.id;\n'''\npd.read_sql_query(query, conn)","key":"x4ph6GcsJ9"},{"type":"outputs","id":"6tDuDuaqQr4QM5kzlJ2vZ","children":[],"key":"UR2GZ3lopG"}],"identifier":"38f8aa2d","html_id":"38f8aa2d","key":"POWlBsfyGJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"14. RIGHT JOIN y FULL JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aYu6tnIrFE"}],"identifier":"id-14-right-join-y-full-join","label":"14. RIGHT JOIN y FULL JOIN","html_id":"id-14-right-join-y-full-join","implicit":true,"key":"pJoD57q2Fo"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Nota: SQLite no soporta directamente RIGHT JOIN ni FULL OUTER JOIN, pero se pueden emular con UNION o invirtiendo las tablas en un LEFT JOIN.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ioUufGIA37"}],"key":"Gl05xIfARw"}],"identifier":"66da9f5f","html_id":"66da9f5f","key":"fJfmf2uVdY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Emulando RIGHT JOIN invirtiendo la lógica con LEFT JOIN\nquery = '''\nSELECT \n    e.nombre AS empleado,\n    d.nombre AS departamento\nFROM departamentos d\nLEFT JOIN empleados e \n    ON e.departamento_id = d.id;\n'''\npd.read_sql_query(query, conn)","key":"W56ijvrPpo"},{"type":"outputs","id":"GacHgo9OMd0qW1PCr_tqM","children":[],"key":"fcX1c1nL74"}],"identifier":"89d4ff99","html_id":"89d4ff99","key":"jBWG4jujZz"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"15. SELF JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yW7dyHydmw"}],"identifier":"id-15-self-join","label":"15. SELF JOIN","html_id":"id-15-self-join","implicit":true,"key":"UdJyHgy67o"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Es una unión regular donde una tabla se une a sí misma.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"MkUoTi9wfG"}],"key":"PRntcZIl9S"}],"identifier":"4e904b88","html_id":"4e904b88","key":"RbDrk335zw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Ejemplo teórico creando una relación de compañeros en el mismo departamento\nquery = '''\nSELECT \n    e1.nombre AS empleado1,\n    e2.nombre AS empleado2,\n    e1.departamento_id\nFROM empleados e1\nJOIN empleados e2 \n    ON e1.departamento_id = e2.departamento_id \n    AND e1.id < e2.id;\n'''\npd.read_sql_query(query, conn)","key":"RttV8meUv5"},{"type":"outputs","id":"QPdMoyn36O8Cj4yisia_9","children":[],"key":"T8zFrlbpOI"}],"identifier":"81046ca6","html_id":"81046ca6","key":"KcWDVXHvvG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"16. Subconsultas (Subqueries)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iv5pPfDh9F"}],"identifier":"id-16-subconsultas-subqueries","label":"16. Subconsultas (Subqueries)","html_id":"id-16-subconsultas-subqueries","implicit":true,"key":"mpE0QV4y4N"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Una consulta dentro de otra consulta.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"aiw5omxNCB"}],"key":"Kk7Z9hG2Gr"}],"identifier":"d85997b9","html_id":"d85997b9","key":"dnOSS8iDEv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT nombre, salario\nFROM empleados\nWHERE salario > (\n    SELECT AVG(salario) FROM empleados\n);\n'''\npd.read_sql_query(query, conn)","key":"uhisSXEi5h"},{"type":"outputs","id":"McW6itBIBl1L1eV1CDhL1","children":[],"key":"vZjhzlMGzS"}],"identifier":"d60aedf6","html_id":"d60aedf6","key":"M9LYdRo7eH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"17. CTEs (Common Table Expressions)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iPLQBKhtXo"}],"identifier":"id-17-ctes-common-table-expressions","label":"17. CTEs (Common Table Expressions)","html_id":"id-17-ctes-common-table-expressions","implicit":true,"key":"tAmhvjfy5z"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Las CTEs proporcionan un conjunto de resultados temporal con nombre que se puede referenciar dentro de una sentencia SELECT, INSERT, UPDATE o DELETE.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"JdGlGGDHHq"}],"key":"b8aBL0LSTV"}],"identifier":"8802a0c5","html_id":"8802a0c5","key":"ZLga4KDUVQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nWITH PromedioSalarios AS (\n    SELECT departamento_id, AVG(salario) as promedio\n    FROM empleados\n    GROUP BY departamento_id\n)\nSELECT \n    e.nombre,\n    e.salario,\n    p.promedio\nFROM empleados e\nJOIN PromedioSalarios p \n    ON e.departamento_id = p.departamento_id\nWHERE e.salario > p.promedio;\n'''\npd.read_sql_query(query, conn)","key":"yTU2MZ5k0r"},{"type":"outputs","id":"g2qjBfxWkbu5gMFh11bt0","children":[],"key":"jXzcFFrIIE"}],"identifier":"f595c74d","html_id":"f595c74d","key":"BUSemYuxgb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Cerrar la conexión\nconn.close()","key":"blghzEtAUF"},{"type":"outputs","id":"G3JI4pfeKFlBx8eRlpgWw","children":[],"key":"a6xDtuMeHQ"}],"identifier":"fb5aee38","html_id":"fb5aee38","key":"N9ZuD4pIqG"}],"key":"YXGITnC3MZ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Introducción a SQL","url":"/sql-basico","group":"Módulo 1 - FUNDAMENTOS"},"next":{"title":"SQL Avanzado: Análisis de Datos y Window Functions","url":"/sql-avanzado","group":"Módulo 1 - FUNDAMENTOS"}}},"domain":"http://localhost:3000"}