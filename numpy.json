las 0 y 1, columnas 1 y 2)\nprint(arr[0:2, 1:])","key":"NpWw6UhhBJ"},{"type":"outputs","id":"sba9xWTo-1FJDXfEGuyUp","children":[],"key":"S40UrLOOrD"}],"identifier":"8a0a6fe1","html_id":"8a0a6fe1","key":"syl2BTCYJJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"04 - Operaciones con Arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Jb9M7cPJnZ"}],"identifier":"id-04-operaciones-con-arrays","label":"04 - Operaciones con Arrays","html_id":"id-04-operaciones-con-arrays","implicit":true,"key":"lPaa4grmPx"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Las operaciones aritméticas en arrays operan elemento por elemento (element-wise).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"imwvG1xmIB"}],"key":"eQ4I5qog76"}],"identifier":"8ace741a","html_id":"8ace741a","key":"AZ0u8o017i"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"x = np.array([1, 2, 3])\ny = np.array([4, 5, 6])\n\n# Suma\nprint(x + y)\n\n# Multiplicación elemento a elemento\nprint(x * y)\n\n# Producto punto (dot product)\nprint(np.dot(x, y))","key":"dICyExKH6K"},{"type":"outputs","id":"mqp4TvaY8KbEyH6bjFEQ3","children":[],"key":"by4fMWX78A"}],"identifier":"5b333a27","html_id":"5b333a27","key":"e4tkE4fvTj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"05 - Broadcasting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"e5BOe0hC6l"}],"identifier":"id-05-broadcasting","label":"05 - Broadcasting","html_id":"id-05-broadcasting","implicit":true,"key":"ZwrUdVoYzn"},{"type":"paragraph","position":{"start