,"end":{"line":3,"column":1}},"key":"b7nrfV2d4R"}],"key":"CZUTZZkvu0"}],"identifier":"6fc306a7","html_id":"6fc306a7","key":"YXCCFQSDX6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\nimport scipy.stats as stats\n\n# Configuración de estilo para los gráficos\nplt.style.use('seaborn-v0_8-whitegrid')","key":"N7dJ7ny52U"},{"type":"outputs","id":"4BS6ESOBJO6GlZ--qzHXR","children":[],"key":"wU2kiY4mPl"}],"identifier":"58859256","html_id":"58859256","key":"j9vtHUX4aF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Teorema de Bayes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RscjtJlwmt"}],"identifier":"id-2-teorema-de-bayes","label":"2. Teorema de Bayes","html_id":"id-2-teorema-de-bayes","implicit":true,"key":"H7hBBxsccI"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"El Teorema de Bayes es fundamental en Machine Learning (por ejemplo, en el clasificador Naive Bayes). Permite calcular la probabilidad condicional de un evento a partir de distribuciones de probabilidad a priori.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DYdZdyrZmY"}],"key":"l4CFiKxWcm"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"P(A|B) = [P(B|A) * P(A)] / P(B)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"u4nDgCWFEE"}],"key":"iRQtlRsdNL"}],"identifier":"f3f3156a","html_id":"f3f3156a","key":"vkRtkorQfj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def teorema_bayes(p_a, p_b_dado_a, p_b_dado_no_a):\n    p_no_a = 1 - p_a\n    p_b = (p_b_dado_a * p_a) + (p_b_dado_no_a * p_no_a)\n    p_a_dado_b = (p_b_dado_a * p_a) / p_b\n    return p_a_dado_b\n\n# Ejemplo: Probabilidad de tener una enfermedad dado un test positivo\np_enfermedad = 0.01\np_positivo_dado_enfermo = 0.99\np_positivo_dado_sano = 0.05\n\nresultado = teorema_bayes(p_enfermedad, p_positivo_dado_enfermo, p_positivo_dado_sano)\nprint(f\"Probabilidad real de tener la enfermedad dado un test positivo: {resultado:.4f}\")","key":"TE6kQWsLfU"},{"type":"outputs","id":"5cNS_7opLrthOXaIl1tU7","children":[],"key":"RPC2GZ6Nsy"}],"identifier":"763122bf","html_id":"763122bf","key":"W8W4qJFmix"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Distribuciones de Probabilidad","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZLTdpDRt50"}],"identifier":"id-3-distribuciones-de-probabilidad","label":"3. Distribuciones de Probabilidad","html_id":"id-3-distribuciones-de-probabilidad","implicit":true,"key":"Ga3CPwhDHS"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Las distribuciones describen cómo se reparten las probabilidades de los posibles valores de una variable aleatoria. Se dividen en discretas y continuas.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"P2dqi5f8j0"}],"key":"ixdQuiNjBc"}],"identifier":"2af33e73","html_id":"2af33e73","key":"gUxqi0Lkdx"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3.1 Distribución Normal (Gaussiana)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hcFp4MMcel"}],"identifier":"id-3-1-distribuci-n-normal-gaussiana","label":"3.1 Distribución Normal (Gaussiana)","html_