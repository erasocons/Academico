by(\"Categoria\")[\"Venta_Total\"].sum().reset_index()\nprint(ventas_por_categoria)","key":"U9pPHYjikJ"},{"type":"outputs","id":"wkd9gb1jHWP-FVwJP5bJB","children":[],"key":"XrswFkyX5o"}],"identifier":"09545ac5","html_id":"09545ac5","key":"ES3ZhNjDRh"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Visualización de Datos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"caNELB9ZfH"}],"identifier":"id-5-visualizaci-n-de-datos","label":"5. Visualización de Datos","html_id":"id-5-visualizaci-n-de-datos","implicit":true,"key":"NJLAOqYfZi"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Generamos gráficos para comunicar visualmente los resultados obtenidos del análisis.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uFQiYIyHZB"}],"key":"qTvWeMPcRz"}],"identifier":"1721fccc","html_id":"1721fccc","key":"EXLOHVIn6U"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Gráfico de barras: Ventas Totales por Categoría\nplt.figure(figsize=(8, 5))\nsns.barplot(data=ventas_por_categoria, x=\"Categoria\", y=\"Venta_Total\", palette=\"Blues_d\")\nplt.title(\"Ventas Totales por Categoría de Producto\")\nplt.xlabel(\"Categoría\")\nplt.ylabel(\"Venta Total ($)\")\nplt.show()","key":"sJzM4ciTM5"},{"type":"outputs","id":"H-XK7WwTRxRpUXP7tSgfW","children":[],"key":"HHUbaSMjLJ"}],"identifier":"cb41c51e","html_id":"cb41c51e","key":"b61kyl5fQE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Gráfico de cajas (Boxplot): Distribución de precios por región\nplt.figure(figsize=(8, 5))\nsns.boxplot(data=df, x=\"Region\", y=\"Precio_Unitario\", palette=\"Set2\")\nplt.title(\"Distribución de Precios Unitarios por Región\")\nplt.xlabel(\"Región\")\nplt.ylabel(\"Precio Unitario ($)\")\nplt.show()","key":"zcaPN27HPu"},{"type":"outputs","id":"_9MXPCLW0Fp71HWORi-eG","children":[],"key":"C3oTehcXFs"}],"identifier":"a7f62062","html_id":"a7f62062","key":"VMMNw3eLjn"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"El analista de datos no solo dice qué pasó (eso es solo reportar), sino que investiga por qué pasó.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZYssZRV2DY"}],"key":"nDfRCXyhTl"}],"key":"HRGkTXycb9"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"En el mundo profesional, esta función se conoce técnicamente como Analítica Diagnóstica.🔍 ¿Cómo encuentra el analista las causas de algo?Para entenderlo de forma sencilla, el analista opera como un detective de datos a través de estos pasos:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jmR38DxBel"}],"key":"BjF5K0YZj3"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"(El síntoma): El negocio nota un problema. Ejemplo: “Las ventas de la app cayeron un 20% este mes”.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"tnFCE5TQal"}],"key":"S2BRqRC5j8"}],"key":"IIU8tTW39n"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"(La investigación): El analista cruza variables, filtra fechas y compara segmentos.Paso","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"hcNvriNvEs"}],"key":"BbIoGBBZES"}],"key":"vuVCkW5JUD"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"(La causa raíz): El analista encuentra el motivo real. Ejemplo: “La caída ocurrió solo en usuarios de Android después de la última actualización del día 5”.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"tHajK2RIyG"}],"key":"YUzy38jyqS"}],"key":"ZAjWjh4GJr"}],"key":"Vu6NWKnP9c"}],"identifier":"90930cfd","html_id":"90930cfd","key":"DYrXox9ka8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Conclusiones","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DuBc4podbo"}],"identifier":"id-6-conclusiones","label":"6. Conclusiones","html_id":"id-6-conclusiones","implicit":true,"key":"OZXkZFxwa3"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"El proceso de limpieza permitió corregir los valores faltantes sin perder registros valiosos.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qqJAywvSni"}],"key":"VeyFPQ8Szw"}],"key":"Hg9RUxPbvr"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"La categoría ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"m9BpMcfmmW"},{"type":"strong",