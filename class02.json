 \"Ropa\", \"Hogar\", \"Deportes\"], n_filas),\n    \"Cantidad\": np.random.randint(1, 10, n_filas),\n    \"Precio_Unitario\": np.round(np.random.uniform(10.0, 500.0, n_filas), 2),\n    \"Region\": np.random.choice([\"Norte\", \"Sur\", \"Este\", \"Oeste\"], n_filas)\n}\n\ndf = pd.DataFrame(data)\n\n# Introducimos algunos valores nulos artificialmente para practicar la limpieza\ndf.loc[df[\"Cantidad\"].sample(10, random_state=42).index, \"Cantidad\"] = np.nan\n\n# Visualizamos las primeras filas\ndf.head()","key":"IXv6VN7yet"},{"type":"outputs","id":"4b5anrxmO9_HgJ7F2dXm7","children":[],"key":"wVIdDmKaZS"}],"identifier":"3ed292bc","html_id":"3ed292bc","key":"sDhvywSEad"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Limpieza y Preparación de Datos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ob81vYc5fe"}],"identifier":"id-3-limpieza-y-preparaci-n-de-datos","label":"3. Limpieza y Preparación de Datos","html_id":"id-3-limpieza-y-preparaci-n-de-datos","implicit":true,"key":"wmMwSoEJei"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Revisamos la estructura del DataFrame, identificamos valores faltantes y aplicamos las transformaciones necesarias.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"T8BmPwMGlK"}],"key":"WZ3bIB55aF"}],"identifier":"fd2b71eb","html_id":"fd2b71eb","key":"vLGDXyL2qs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Información general del DataFrame\nprint(df.info())","key":"oL9Nc6wPvt"},{"type":"outputs","id":"F-j3wC3MR27PRNlvVcCDz","children":[],"key":"DGocnDH9fY"}],"identifier":"16a875ed","html_id":"16a875ed","key":"rxZSC8Ziz3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Rellenamos los valores nulos de 'Cantidad' con la mediana de la columna\nmediana_cantidad = df[\"Cantidad\"].median()\ndf[\"Cantidad\"].fillna(mediana_cantidad, inplace=True)\n\n# Creamos una nueva columna calculada: 'Venta_Total'\ndf[\"Venta_Total\"] = df[\"Cantidad\"] * df[\"Precio_Unitario\"]\n\n# Verificamos que no queden nulos\nprint(df.isnull().sum())","key":"nk5L8qZ8La"},{"type":"outputs","id":"KpypEUIgYqg9RF9uzNBZr","children":[],"key":"LODHBKJXsE"}],"identifier":"0b44df05","html_id":"0b44df05","key":"qmYjWFla7m"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Análisis Exploratorio de Datos (EDA)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Z9kkPi1ljw"}],"identifier":"id-4-an-lisis-exploratorio-de-datos-eda","label":"4. Análisis Exploratorio de Datos (EDA)","html_id":"id-4-an-lisis-exploratorio-de-datos-eda","implicit":true,"key":"jtcXAM8XNB"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Calculamos estadísticas descriptivas básicas para entender la distribución de las variables numéricas y categóricas.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"p6KTjdJCN4"}],"key":"YqaF321mnl"}],"identifier":"e713d01d","html_id":"e713d01d","key":"Rt1tQKXlAw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Estadísticas descriptivas\ndf.describe()","key":"q97J2XyVd5"},{"type":"outputs","id":"-FEb1F33xrEL0QcdPaQto","children":[],"key":"GaUrIzPUdl"}],"identifier":"92e3eef9","html_id":"92e3eef9","key":"FUR6jtpqyp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Ventas totales por categoría\nventas_por_categoria = df.groupby(\"Categoria\")[\"Venta_Total\"].sum().reset_index()\nprint(ventas_por_categoria)","key":"HNaQbVLAT9"},{"type":"outputs","id":"yPrcCvq8AEuGb4fcG9LSY","children":[],"key":"vhR2ZFOYFV"}],"identifier":"09545ac5","html_id":"09545ac5","key":"MY0K4sabRO"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Visualización de Datos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"r7HEKcvUtc"}],"identifier":"id-5-visualizaci-n-de-datos","label":"5. Visualización de Datos","html_id":"id-5-visualizaci-n-de-datos","implicit":true,"key":"FVlBWOt0FS"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Generamos gráficos para comunicar visualmente los resultados obtenidos del análisis.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"t6Vb3RtdlN"}],"key":"aFkSkTMEyp"}],"identifier":"1721fccc","html_id":"1721fccc","key":"k8OsNnEKiH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Gráfico de barras: Ventas Totales por Categoría\nplt.figure(figsize=(8, 5))\nsns.barplot(data=ventas_por_categoria, x=\"Categoria\", y=\"Venta_Total\", palette=\"Blues_d\")\nplt.title(\"Ventas Totales por Categoría de Producto\")\nplt.xlabel(\"Categoría\")\nplt.ylabel(\"Venta Total ($)\")\nplt.show()","key":"qaBfDDAGNh"},{"type":"outputs","id":"_M1ISZMNOamVpu9vYaiX5","children":[],"key":"P2QBi6EZhn"}],"identifier":"cb41c51e","html_id":"cb41c51e","key":"IOTReG49VS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Gráfico de cajas (Boxplot): Distribución de precios por región\nplt.figure(figsize=(8, 5))\nsns.boxplot(data=df, x=\"Region\", y=\"Precio_Unitario\", palette=\"Set2\")\nplt.title(\"Distribución de Precios Unitarios por Región\")\nplt.xlabel(\"Región\")\nplt.ylabel(\"Precio Unitario ($)\")\nplt.show()","key":"O7iPWl5pmb"},{"type":"outputs","id":"1lmb352ZE5BsRyQkW-CdT","children":[],"key":"JFMB2kb944"}],"identifier":"a7f62062","html_id":"a7f62062","key":"paeOvEsK9z"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"El analista de datos no solo dice qué pasó (eso es solo reportar), sino que investiga por qué pasó.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rZZK8ERE2i"}],"key":"fpNElk993i"}],"key":"LWbF6qkSzt"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"En el mundo profesional, esta función se conoce técnicamente como Analítica Diagnóstica.🔍 ¿Cómo encuentra el analista las causas de algo?Para entenderlo de forma sencilla, el analista opera como un detective de datos a través de estos pasos:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"X1nLNNt78X"}],"key":"uGMWmxw8Lo"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"(El síntoma): El negocio nota un problema. Ejemplo: “Las ventas de la app cayeron un 20% este mes”.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"dGIvT4WcWp"}],"key":"ZrzKIjUVdO"}],"key":"vRFONX6cVO"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"(La investigación): El analista cruza variables, filtra fechas y compara segmentos.Paso","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"HLFQdBe1Rt"}],"key":"Ncgu8i3DSx"}],"key":"WwPAHR5HWZ"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"(La causa raíz): El analista encuentra el motivo real. Ejemplo: “La caída ocurrió solo en usuarios de Android después de la última actualización del día 5”.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"uCO9ROwrUc"}],"key":"vuHNRBZX7e"}],"key":"ATnENrvmZq"}],"key":"tME3h0Jif9"}],"identifier":"90930cfd","html_id":"90930cfd","key":"RuJXVK9OMq"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Conclusiones","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rBZ4lghsib"}],"identifier":"id-6-conclusiones","label":"6. Conclusiones","html_id":"id-6-conclusiones","implicit":true,"key":"AOOJpILbTM"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"El proceso de limpieza permitió corregir los valores faltantes sin perder registros valiosos.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"v9SRNLhOiu"}],"key":"VGh3VApZGd"}],"key":"udM2UzGnIk"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"La categoría ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"nBjMuWWjMn"},{"type":"strong",