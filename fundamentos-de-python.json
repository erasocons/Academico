4-estructuras-de-control-condicionales-y-bucles","implicit":true,"key":"JH4LHZ9Sik"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Permiten tomar decisiones y repetir bloques de código.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yEKhcB1TSn"}],"key":"RC5tx0ZK1b"}],"identifier":"4434e2a7","html_id":"4434e2a7","key":"QnSBaxpDN3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"edad = 20\nif edad >= 18:\n    print(\"Mayor de edad\")\nelif edad > 12:\n    print(\"Adolescente\")\nelse:\n    print(\"Niño\")\n\n# Bucle For\nfor i in range(3):\n    print(\"Iteración for:\", i)\n\n# Bucle While con control\ncontador = 0\nwhile contador < 3:\n    if contador == 1:\n        contador += 1\n        continue\n    print(\"Contador while:\", contador)\n    contador += 1","key":"cbKcPH17Zs"},{"type":"outputs","id":"urjrd6X5rYvwwIK0ixzrC","children":[],"key":"K4oLIenObu"}],"identifier":"7bfc6d5a","html_id":"7bfc6d5a","key":"oqlnfJ5Bu2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Funciones y Argumentos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tSbZ9Lajlv"}],"identifier":"id-5-funciones-y-argumentos","label":"5. Funciones y Argumentos","html_id":"id-5-funciones-y-argumentos","implicit":true,"key":"KrOjjXrDdr"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Las funciones se definen con ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BIq48Mf8kM"},{"type":"inlineCode","value":"def","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TNfnD9itE3"},{"type":"text","value":" y pueden recibir argumentos posicionales, nombrados, ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"glkupapT7B"},{"type":"inlineCode","value":"*args","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EEDL7rLTOG"},{"type":"text","value":" y ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Iq0cJk7Ipq"},{"type":"inlineCode","value":"**kwargs","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EbBhK5fQrR"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qh4UPgMWHt"}],"key":"vmHznLz3NE"}],"identifier":"9fb70963","html_id":"9fb70963","key":"blYV8dqe1h"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def sumar_todo(*args, **kwargs):\n    total = sum(args)\n    print(\"Argumentos extra:\", kwargs)\n    return total\n\nresultado = sumar_todo(1, 2, 3, 4, operacion=\"suma\")\nprint(\"Resultado:\", resultado)","key":"Wh6IRA9L40"},{"type":"outputs","id":"sgbZfAcLtuCT5QfMsNs7W","children":[],"key":"xObTrH8MJU"}],"identifier":"1de87e6c","html_id":"1de87e6c","key":"vmRdtwHeDl"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Módulos, Excepciones y Manejo de Archivos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"prcFS20S21"}],"identifier":"id-6-m-dulos-excepciones-y-manejo-de-archivos","label":"6. Módulos, Excepciones y Manejo de Archivos","html_id":"id-6-m-dulos-excepciones-y-manejo-de-archivos","implicit":true,"key":"jRNZySBvfd"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Importación de módulos, bloques try-except-finally y lectura/escritura de archivos.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mxaTS0D7Ng"}],"key":"eaEk1ERD3c"}],"identifier":"e90a7cbf","html_id":"e90a7cbf","key":"EJbVreMVpn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import math\n\nprint(\"Raíz cuadrada de 16:\", math.sqrt(16))\n\ntry:\n    resultado = 10 / 0\nexcept ZeroDivisionError:\n    print(\"Error: División por cero\")\nfinally:\n    print(\"Bloque finally ejecutado\")\n\n# Manejo de archivos (crear y leer)\nwith open(\"test.txt\", \"w\") as f:\n    f.write(\"Hola mundo desde un archivo en Python\")\n\nwith open(\"test.txt\", \"r\") as f:\n    contenido = f.read()\n    print(\"Contenido del archivo:\", contenido)","key":"hVvtGYxT3s"},{"type":"outputs","id":"HuRTxZRt5Db9k_MQdYY9o","children":[],"key":"h5OqwXji41"}],"identifier":"877dd4b9","html_id":"877dd4b9","key":"CHXPVa1LvM"}],"key":"EXVB8KgqwO"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CLASE01: El Poder de la Analítica de Datos","url":"/class01","group":"Módulo 1 - FUNDAMENTOS"}}},"domain":"http://localhost:3000"}