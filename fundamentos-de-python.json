4-estructuras-de-control-condicionales-y-bucles","implicit":true,"key":"Lsvv5IQdi1"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Permiten tomar decisiones y repetir bloques de código.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"MyjxSNq178"}],"key":"e7xQ7hboKR"}],"identifier":"4434e2a7","html_id":"4434e2a7","key":"Dh2KANPAbf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"edad = 20\nif edad >= 18:\n    print(\"Mayor de edad\")\nelif edad > 12:\n    print(\"Adolescente\")\nelse:\n    print(\"Niño\")\n\n# Bucle For\nfor i in range(3):\n    print(\"Iteración for:\", i)\n\n# Bucle While con control\ncontador = 0\nwhile contador < 3:\n    if contador == 1:\n        contador += 1\n        continue\n    print(\"Contador while:\", contador)\n    contador += 1","key":"oF5w2cuJdA"},{"type":"outputs","id":"hc9ofi1i_GmILPs1-e82y","children":[],"key":"AapMLs6UPL"}],"identifier":"7bfc6d5a","html_id":"7bfc6d5a","key":"mNQSchLrs1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Funciones y Argumentos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"h8yzkSM2fJ"}],"identifier":"id-5-funciones-y-argumentos","label":"5. Funciones y Argumentos","html_id":"id-5-funciones-y-argumentos","implicit":true,"key":"V83bxYWJ97"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Las funciones se definen con ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"F5KhqjURGS"},{"type":"inlineCode","value":"def","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OKCsc5RRfg"},{"type":"text","value":" y pueden recibir argumentos posicionales, nombrados, ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zoqbkEC9lI"},{"type":"inlineCode","value":"*args","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rgnCTTZd2v"},{"type":"text","value":" y ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YTUhltpaCS"},{"type":"inlineCode","value":"**kwargs","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fyJiPZ3D0k"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dNII9SR3PE"}],"key":"qsxqpbD9zB"}],"identifier":"9fb70963","html_id":"9fb70963","key":"F7NyOpOhVH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def sumar_todo(*args, **kwargs):\n    total = sum(args)\n    print(\"Argumentos extra:\", kwargs)\n    return total\n\nresultado = sumar_todo(1, 2, 3, 4, operacion=\"suma\")\nprint(\"Resultado:\", resultado)","key":"QghrTtmQPy"},{"type":"outputs","id":"9-7YsXvPvLc3wCWW6Ybxj","children":[],"key":"iZU0M9TfSR"}],"identifier":"1de87e6c","html_id":"1de87e6c","key":"tdt0Nk1s2b"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Módulos, Excepciones y Manejo de Archivos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zK2Xa7gPj5"}],"identifier":"id-6-m-dulos-excepciones-y-manejo-de-archivos","label":"6. Módulos, Excepciones y Manejo de Archivos","html_id":"id-6-m-dulos-excepciones-y-manejo-de-archivos","implicit":true,"key":"UEgOxVKVml"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Importación de módulos, bloques try-except-finally y lectura/escritura de archivos.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GdqhQ0FhDe"}],"key":"bkcQ9VrxTN"}],"identifier":"e90a7cbf","html_id":"e90a7cbf","key":"LtuvrDXzdo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import math\n\nprint(\"Raíz cuadrada de 16:\", math.sqrt(16))\n\ntry:\n    resultado = 10 / 0\nexcept ZeroDivisionError:\n    print(\"Error: División por cero\")\nfinally:\n    print(\"Bloque finally ejecutado\")\n\n# Manejo de archivos (crear y leer)\nwith open(\"test.txt\", \"w\") as f:\n    f.write(\"Hola mundo desde un archivo en Python\")\n\nwith open(\"test.txt\", \"r\") as f:\n    contenido = f.read()\n    print(\"Contenido del archivo:\", contenido)","key":"vlWoP2iswK"},{"type":"outputs","id":"dk9iYmMzHCDPdk68mBJDA","children":[],"key":"jeW8193gse"}],"identifier":"877dd4b9","html_id":"877dd4b9","key":"n0yj8fYIPx"}],"key":"n6H9ZLuOtd"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CLASE01: El Poder de la Analítica de Datos","url":"/class01","group":"Módulo 1 - FUNDAMENTOS"}}},"domain":"http://localhost:3000"}