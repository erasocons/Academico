ilas 0 y 1, columnas 1 y 2)\nprint(arr[0:2, 1:])","key":"F1YjwRokOg"},{"type":"outputs","id":"ae21JqQZSQ9VBJUOn_HWU","children":[],"key":"IiPkNh26QV"}],"identifier":"8a0a6fe1","html_id":"8a0a6fe1","key":"y3n39qqQUT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"04 - Operaciones con Arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"l16Vx2KUHa"}],"identifier":"id-04-operaciones-con-arrays","label":"04 - Operaciones con Arrays","html_id":"id-04-operaciones-con-arrays","implicit":true,"key":"W5SvmsE30k"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Las operaciones aritméticas en arrays operan elemento por elemento (element-wise).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hYMIsmSzUp"}],"key":"aNwm2PMvWb"}],"identifier":"8ace741a","html_id":"8ace741a","key":"RTBAbjBzzZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"x = np.array([1, 2, 3])\ny = np.array([4, 5, 6])\n\n# Suma\nprint(x + y)\n\n# Multiplicación elemento a elemento\nprint(x * y)\n\n# Producto punto (dot product)\nprint(np.dot(x, y))","key":"iZIQJZGfsh"},{"type":"outputs","id":"BW7pKRLqei5b_3PFTRo7D","children":[],"key":"qH4qEekfGE"}],"identifier":"5b333a27","html_id":"5b333a27","key":"ixoaTAiuvc"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"05 - Broadcasting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YwsImzXQJ7"}],"identifier":"id-05-broadcasting","label":"05 - Broadcasting","html_id":"id-05-broadcasting","implicit":true,"key":"FuGhoqQpyi"},{"type":"paragraph","position":{"star