las 0 y 1, columnas 1 y 2)\nprint(arr[0:2, 1:])","key":"ALBO63v3r5"},{"type":"outputs","id":"2v8UZFbuj99QKB8XwwFI7","children":[],"key":"EQeIeKLzX7"}],"identifier":"8a0a6fe1","html_id":"8a0a6fe1","key":"g9BqYnm5dq"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"04 - Operaciones con Arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Opq5dGWUqg"}],"identifier":"id-04-operaciones-con-arrays","label":"04 - Operaciones con Arrays","html_id":"id-04-operaciones-con-arrays","implicit":true,"key":"R2leWeYXsr"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Las operaciones aritméticas en arrays operan elemento por elemento (element-wise).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"i8Z9mXT5Zn"}],"key":"nkFJJNfvIB"}],"identifier":"8ace741a","html_id":"8ace741a","key":"oHa0psx7La"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"x = np.array([1, 2, 3])\ny = np.array([4, 5, 6])\n\n# Suma\nprint(x + y)\n\n# Multiplicación elemento a elemento\nprint(x * y)\n\n# Producto punto (dot product)\nprint(np.dot(x, y))","key":"SAZ3UGxJfD"},{"type":"outputs","id":"otpp54eeRhOL5HLXuv9W4","children":[],"key":"s28shIHHEn"}],"identifier":"5b333a27","html_id":"5b333a27","key":"fl5WtXMt7s"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"05 - Broadcasting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gkFZHK1GYk"}],"identifier":"id-05-broadcasting","label":"05 - Broadcasting","html_id":"id-05-broadcasting","implicit":true,"key":"EnIcI6uNfQ"},{"type":"paragraph","position":{"start