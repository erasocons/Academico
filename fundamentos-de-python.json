s posicionales, nombrados, ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iBzwOwAL0W"},{"type":"inlineCode","value":"*args","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"nCn4kcvC9L"},{"type":"text","value":" y ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KSqCsUfZfh"},{"type":"inlineCode","value":"**kwargs","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OTQKgtf7Nh"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"N0FOdXJfA7"}],"key":"nJSdCetjxQ"}],"identifier":"9fb70963","html_id":"9fb70963","key":"hv6cdI9hYf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def sumar_todo(*args, **kwargs):\n    total = sum(args)\n    print(\"Argumentos extra:\", kwargs)\n    return total\n\nresultado = sumar_todo(1, 2, 3, 4, operacion=\"suma\")\nprint(\"Resultado:\", resultado)","key":"bPJCO4XxJt"},{"type":"outputs","id":"T_EA2o-25SH0jAe0fgpMa","children":[],"key":"FVRZ4FWI2w"}],"identifier":"1de87e6c","html_id":"1de87e6c","key":"Bq6Ba4GYr0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Módulos, Excepciones y Manejo de Archivos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DcluxjfOuF"}],"identifier":"id-6-m-dulos-excepciones-y-manejo-de-archivos","label":"6. Módulos, Excepciones y Manejo de Archivos","html_id":"id-6-m-dulos-excepciones-y-manejo-de-archivos","implicit":true,"key":"Er6xt1ewah"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Importación de módulos, bloques try-except-finally y lectura/escritura de archivos.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bAUi10JVxg"}],"key":"U97ke2Pdaf"}],"identifier":"e90a7cbf","html_id":"e90a7cbf","key":"SuW06RJaax"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import math\n\nprint(\"Raíz cuadrada de 16:\", math.sqrt(16))\n\ntry:\n    resultado = 10 / 0\nexcept ZeroDivisionError:\n    print(\"Error: División por cero\")\nfinally:\n    print(\"Bloque finally ejecutado\")\n\n# Manejo de archivos (crear y leer)\nwith open(\"test.txt\", \"w\") as f:\n    f.write(\"Hola mundo desde un archivo en Python\")\n\nwith open(\"test.txt\", \"r\") as f:\n    contenido = f.read()\n    print(\"Contenido del archivo:\", contenido)","key":"u1OFoFehhH"},{"type":"outputs","id":"EzyfV1ijbQJqZWmXCFCw4","children":[],"key":"MyP4d0HSvf"}],"identifier":"877dd4b9","html_id":"877dd4b9","key":"dhjLClI67r"}],"key":"V6iHdNR5Tz"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Flujo de Trabajo del Analista de Datos (Data Analyst Workflow)","url":"/class02","group":"Módulo 1 - FUNDAMENTOS"},"next":{"title":"Introducción a NumPy","url":"/numpy","group":"Módulo 1 - FUNDAMENTOS"}}},"domain":"http://pre.render"}