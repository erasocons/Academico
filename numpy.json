ilas 0 y 1, columnas 1 y 2)\nprint(arr[0:2, 1:])","key":"RFzb35Mf5O"},{"type":"outputs","id":"q0pDVUHRGKpq1_npBr4i1","children":[],"key":"pIeIVZPUqZ"}],"identifier":"8a0a6fe1","html_id":"8a0a6fe1","key":"D6E8f4EFR0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"04 - Operaciones con Arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ge0hUTajDM"}],"identifier":"id-04-operaciones-con-arrays","label":"04 - Operaciones con Arrays","html_id":"id-04-operaciones-con-arrays","implicit":true,"key":"nutFno00EQ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Las operaciones aritméticas en arrays operan elemento por elemento (element-wise).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XrBIocjC2o"}],"key":"cTp3yyX5IW"}],"identifier":"8ace741a","html_id":"8ace741a","key":"jcZhSYzpaO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"x = np.array([1, 2, 3])\ny = np.array([4, 5, 6])\n\n# Suma\nprint(x + y)\n\n# Multiplicación elemento a elemento\nprint(x * y)\n\n# Producto punto (dot product)\nprint(np.dot(x, y))","key":"Yk63bWFYqf"},{"type":"outputs","id":"chTcqh6NqOeuU6sAnzwYY","children":[],"key":"xLdTadfjML"}],"identifier":"5b333a27","html_id":"5b333a27","key":"IaYy1zw9M9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"05 - Broadcasting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"p7f9LKom9Q"}],"identifier":"id-05-broadcasting","label":"05 - Broadcasting","html_id":"id-05-broadcasting","implicit":true,"key":"rOaRIWFcBK"},{"type":"paragraph","position":{"star