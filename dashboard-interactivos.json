andas as pd","key":"xoAGNLeKcJ"},{"type":"outputs","id":"zWIlrXTV8xJQTXL6SvS4p","children":[],"key":"psHfTj8UNu"}],"identifier":"c8821fe4","html_id":"c8821fe4","key":"xTqZjZT8A3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Preparación de Datos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yjo086OpRF"}],"identifier":"id-3-preparaci-n-de-datos","label":"3. Preparación de Datos","html_id":"id-3-preparaci-n-de-datos","implicit":true,"key":"Is9eqgypYb"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Para este ejemplo, utilizaremos un conjunto de datos integrado en Plotly Express (Gapminder) para visualizar la relación entre el PIB per cápita y la esperanza de vida.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LPdGGBdxlC"}],"key":"NkAjHNRB5C"}],"identifier":"df37ffe0","html_id":"df37ffe0","key":"kIgRNdFXb9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Cargar datos de ejemplo\ndf = px.data.gapminder()\nprint(df.head())","key":"mcdpSaBK4q"},{"type":"outputs","id":"C3WxIyhXl-GwPyym43XI6","children":[],"key":"yUYD1isqHO"}],"identifier":"47e602b1","html_id":"47e602b1","key":"NJkhk3Hs10"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Estructura y Layout del Dashboard","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qppjxNv29Q"}],"identifier":"id-4-estructura-y-layout-del-dashboard","label":"4. Estructura y Layout del Dashboard","html_id":"id-4-estructura-y-layout-del-dashboard","implicit":true,"key":"KxEGqeX2c8"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"El layout define la apariencia visual del dashboard. Utilizaremos componentes HTML para los títulos y controles deslizantes (sliders), y un componente ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"o6B92qRlJJ"},{"type":"inlineCode","value":"dcc.Graph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mQ529yjeFo"},{"type":"text","value":" para mostrar el gráfico interactivo.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BU5spcxmeo"}],"key":"Ett6OTIw3b"}],"identifier":"598cf94a","html_id":"598cf94a","key":"epSSV0oEDy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"app = dash.Dash(__name__)\n\napp.layout = html.Div([\n    html.H1(\"Dashboard Interactivo de Población y Economía\", style={'textAlign': 'center'}),\n    \n    html.Div([\n        html.Label(\"Selecciona el año:\"),\n        dcc.Slider(\n            id='year-slider',\n            min=df['year'].min(),\n            max=df['year'].max(),\n            step=5,\n            value=df['year'].min(),\n            marks={str(year): str(year) for year in df['year'].unique()}\n        )\n    ], style={'width': '80%', 'padding': '20px', 'margin': 'auto'}),\n    \n    dcc.Graph(id='indicator-graphic')\n])","key":"ZtygSzAb9L"},{"type":"outputs","id":"MhQOL3DeLPKcwjvr5j62o","children":[],"key":"j2TZ2o3tYe"}],"identifier":"3ea2aabe","html_id":"3ea2aabe","key":"HOv8THYzy9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Interactividad con Callbacks","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uwI7jhBAEX"}],"identifier":"id-5-interactividad-con-callbacks","label":"5. Interactividad con Callbacks","html_id":"id-5-interactividad-con-callbacks","implicit":true,"key":"tRLIr3Y28s"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Los callbacks conectan los componentes de entrada (como el slider) con los componentes de salida (como el gráfico), permitiendo que el dashboard responda dinámicamente a las acciones del usuario.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"MzAv2OE1p6"}],"key":"PQXTe0Ck3L"}],"identifier":"ab7e985e","html_id":"ab7e985e","key":"QT7LhlPMnN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"@app.callback(\n    Output('indicator-graphic', 'figure'),\n    [Input('year-slider', 'value')]\n):\ndef update_graph(selected_year):\n    filtered_df = df[df.year == selected_year]\n    \n    fig = px.scatter(\n        filtered_df,\n        x=\"gdpPercap\",\n        y=\"lifeExp\",\n        size=\"pop\",\n        color=\"continent\",\n        hover_name=\"country\",\n        log_x=True,\n        size_max=55,\n        title=f\"Año: {selected_year}\"\n    )\n    \n    fig.update_layout(transition_duration=500)\n    return fig","key":"Szd7QKeW0C"},{"type":"outputs","id":"DYM2eEEnSeNh_5DaAvury","children":[],"key":"UPUcrMyWfC"}],"identifier":"cec5558d","html_id":"cec5558d","key":"ZMHCuqSnf8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Ejecución de la Aplicación","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SPiiCd1l76"}],"identifier":"id-6-ejecuci-n-de-la-aplicaci-n","label":"6. Ejecución de la Aplicación","html_id":"id-6-ejecuci-n-de-la-aplicaci-n","implicit":true,"key":"w0cgsgV5R2"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Finalmente, ejecutamos el servidor de la aplicación Dash. (Nota: Si estás ejecutando esto en un entorno tipo Jupyter Notebook, puedes usar ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yBvVo7g2Qo"},{"type":"inlineCode","value":"app.run_server(mode='inline')","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jCFPxmN3lz"},{"type":"text","value":" o simplemente ejecutarlo de manera estándar).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ymK1Fz0A6x"}],"key":"K7ifVgR6sa"}],"identifier":"d900edfd","html_id":"d900edfd","key":"Mo1vtOGoWO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"if __name__ == '__main__':\n    app.run_server(debug=True, port=8050)","key":"DHgE8QQKnn"},{"type":"outputs","id":"PMb1sT_mouJgR89VkXgfU","children":[],"key":"RwyQa2SJ3T"}],"identifier":"88ab73e8","html_id":"88ab73e8","key":"xJeLniwWfJ"}],"key":"GoPbMEmzyH"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Tutorial: Exploración de Patrones y Relaciones en Datos","url":"/exploraci-n-patrones-relaciones","group":"ANÁLISIS"}}},"domain":"http://pre.render"}