mn":1}},"key":"KKAqFTblYU"}],"key":"B7wBggzcfl"}],"identifier":"e90a7cbf","html_id":"e90a7cbf","key":"b1HNtONH7T"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import math\n\nprint(\"Raíz cuadrada de 16:\", math.sqrt(16))\n\ntry:\n    resultado = 10 / 0\nexcept ZeroDivisionError:\n    print(\"Error: División por cero\")\nfinally:\n    print(\"Bloque finally ejecutado\")\n\n# Manejo de archivos (crear y leer)\nwith open(\"test.txt\", \"w\") as f:\n    f.write(\"Hola mundo desde un archivo en Python\")\n\nwith open(\"test.txt\", \"r\") as f:\n    contenido = f.read()\n    print(\"Contenido del archivo:\", contenido)","key":"ohKRHFX61M"},{"type":"outputs","id":"Vd41weoA4HwLvBwe7uuOw","children":[],"key":"MBUSDN6eEz"}],"identifier":"877dd4b9","html_id":"877dd4b9","key":"cv1oyMUPXW"}],"key":"ObOGuKAF3h"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Flujo de Trabajo del Analista de Datos (Data Analyst Workflow)","url":"/class02","group":"Módulo 1 - FUNDAMENTOS"},"next":{"title":"Introducción a NumPy","url":"/numpy","group":"Módulo 1 - FUNDAMENTOS"}}},"domain":"http://localhost:3000"}