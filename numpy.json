las 0 y 1, columnas 1 y 2)\nprint(arr[0:2, 1:])","key":"EJvzRB4WHn"},{"type":"outputs","id":"CruDnIFpaFZ4W_NqTGALI","children":[],"key":"gwryl83iGK"}],"identifier":"8a0a6fe1","html_id":"8a0a6fe1","key":"TddaWQx2JS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"04 - Operaciones con Arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aoWYOoyH27"}],"identifier":"id-04-operaciones-con-arrays","label":"04 - Operaciones con Arrays","html_id":"id-04-operaciones-con-arrays","implicit":true,"key":"sQOYZoeq2c"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Las operaciones aritméticas en arrays operan elemento por elemento (element-wise).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iLDpca3dbc"}],"key":"xX06mKeeti"}],"identifier":"8ace741a","html_id":"8ace741a","key":"spC0NXhoQ7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"x = np.array([1, 2, 3])\ny = np.array([4, 5, 6])\n\n# Suma\nprint(x + y)\n\n# Multiplicación elemento a elemento\nprint(x * y)\n\n# Producto punto (dot product)\nprint(np.dot(x, y))","key":"ayM5p2KfWm"},{"type":"outputs","id":"yECrb3LdKCMO4tYWoFO40","children":[],"key":"DqQmcKvtHK"}],"identifier":"5b333a27","html_id":"5b333a27","key":"fsT9huPL6u"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"05 - Broadcasting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"w8c1HV4JKG"}],"identifier":"id-05-broadcasting","label":"05 - Broadcasting","html_id":"id-05-broadcasting","implicit":true,"key":"FELc3nY8Yx"},{"type":"paragraph","position":{"start