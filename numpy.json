ilas 0 y 1, columnas 1 y 2)\nprint(arr[0:2, 1:])","key":"ejblKNm1Ty"},{"type":"outputs","id":"K0AJeVmD1oPS2AwGXV76Q","children":[],"key":"YKcPUPNpif"}],"identifier":"8a0a6fe1","html_id":"8a0a6fe1","key":"AMsQSHgRw0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"04 - Operaciones con Arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xkA7leMzWu"}],"identifier":"id-04-operaciones-con-arrays","label":"04 - Operaciones con Arrays","html_id":"id-04-operaciones-con-arrays","implicit":true,"key":"cDgmUyqCtZ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Las operaciones aritméticas en arrays operan elemento por elemento (element-wise).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"q0QMhitRSH"}],"key":"ooacxFrBCL"}],"identifier":"8ace741a","html_id":"8ace741a","key":"PomRFEvOon"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"x = np.array([1, 2, 3])\ny = np.array([4, 5, 6])\n\n# Suma\nprint(x + y)\n\n# Multiplicación elemento a elemento\nprint(x * y)\n\n# Producto punto (dot product)\nprint(np.dot(x, y))","key":"hpepygNtpW"},{"type":"outputs","id":"gDUwjqkNRUMKV81WHDqCO","children":[],"key":"QIYv3eRx0T"}],"identifier":"5b333a27","html_id":"5b333a27","key":"D9wLI80E8V"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"05 - Broadcasting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yUBvxSWtJz"}],"identifier":"id-05-broadcasting","label":"05 - Broadcasting","html_id":"id-05-broadcasting","implicit":true,"key":"MI1zJLfJgo"},{"type":"paragraph","position":{"star