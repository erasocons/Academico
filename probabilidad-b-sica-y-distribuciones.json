":true,"value":"mu, sigma = 0, 1\nx = np.linspace(mu - 3*sigma, mu + 3*sigma, 100)\ny = stats.norm.pdf(x, mu, sigma)\n\nplt.figure(figsize=(8, 4))\nplt.plot(x, y, label='Normal(0, 1)', color='blue')\nplt.title('Función de Densidad de Probabilidad - Distribución Normal')\nplt.xlabel('X')\nplt.ylabel('Densidad de Probabilidad')\nplt.legend()\nplt.show()","key":"EIAOTyIr3S"},{"type":"outputs","id":"B0dDmJZPvUu53S4tXhmWx","children":[],"key":"HrMdPjRtxI"}],"identifier":"0afe5ae7","html_id":"0afe5ae7","key":"E03lJb681l"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3.2 Distribución Binomial","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ou0WLHpWYx"}],"identifier":"id-3-2-distribuci-n-binomial","label":"3.2 Distribución Binomial","html_id":"id-3-2-distribuci-n-binomial","implicit":true,"key":"Lr5gZPQH5O"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Distribución discreta que modela el número de éxitos en ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dtNmEMXpAK"},{"type":"inlineMath","value":"n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>n</mi></mrow><annotation encoding=\"application/x-tex\">n</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">n</span></span></span></span>","key":"o9pBqcgpf3"},{"type":"text","value":" ensayos de Bernoulli independientes con probabilidad de éxito ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mhP08qwQl3"},{"type":"inlineMath","value":"p","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>p</mi></mrow><annotation encoding=\"application/x-tex\">p</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">p</span></span></span></span>","key":"LyMv6dA7xT"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xw2k49bhaE"}],"key":"JQmRxwR0ze"}],"identifier":"18de5ef6","html_id":"18de5ef6","key":"gQ7a4L6s7t"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"n, p = 10, 0.5\nk = np.arange(0, n+1)\nbinomial_pmf = stats.binom.pmf(k, n, p)\n\nplt.figure(figsize=(8, 4))\nplt.bar(k, binomial_pmf, color='orange', alpha=0.7)\nplt.title('Distribución Binomial (n=10, p=0.5)')\nplt.xlabel('Número de Éxitos (k)')\nplt.ylabel('Probabilidad')\nplt.show()","key":"oK6TZJh6LN"},{"type":"outputs","id":"Vt9CrJMz0mjYGManE5WI2","children":[],"key":"lIyj2D4uLq"}],"identifier":"d23b9c1d","html_id":"d23b9c1d","key":"DGN9ZNcAde"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Ley de los Grandes Números (LLN)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZAWv7Za7jb"}],"identifier":"id-4-ley-de-los-grandes-n-meros-lln","label":"4. Ley de los Grandes Números (LLN)","html_id":"id-4-ley-de-los-grandes-n-meros-lln","implicit":true,"key":"txCDEwHkcY"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"La Ley de los Grandes Números establece que a medida que aumenta el número de ensayos en un experimento aleatorio, el promedio de los resultados obtenidos se acerca al valor esperado teórico.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XUL0SEm6Gb"}],"key":"WoiZSbL1oT"}],"identifier":"d29ca976","html_id":"d29ca976","key":"JHoYfX3V4o"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"np.random.seed(42)\ntamanios_muestra = np.arange(10, 5000, 50)\nmedias_muestrales = [np.mean(np.random.binomial(1, 0.5, size=n)) for n in tamanios_muestra]\n\nplt.figure(figsize=(8, 4))\nplt.axhline(0.5, color='red', linestyle='--', label='Valor Teórico (0.5)')\nplt.plot(tamanios_muestra, medias_muestrales, label='Media Muestral')\nplt.title('Ley de los Grandes Números')\nplt.xlabel('Tamaño de la Muestra')\nplt.ylabel('Media')\nplt.legend()\nplt.show()","key":"sGIU2d5fHl"},{"type":"outputs","id":"nL-tMQnrJ8CgA-aUPirEP","children":[],"key":"Yo8rN1f7mM"}],"identifier":"3be9f138","html_id":"3be9f138","key":"DO8pGlkAeS"}],"key":"dWlx7GJ1BV"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Tutorial Completo de Visualización de Datos en Python","url":"/matplotlib-amd-seaborn","group":"Módulo 2 - HERRAMIENTAS"},"next":{"title":"Introducción a la Inferencia Estadística y Pruebas de Hipótesis","url":"/inferencia-estad-stica-y-pruebas-de-hip-tesis","group":"Módulo 3 - ESTADISTICA Y PROBABILIDAD"}}},"domain":"http://pre.render"}