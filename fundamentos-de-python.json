-4-estructuras-de-control-condicionales-y-bucles","implicit":true,"key":"JO6kyjL3I4"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Permiten tomar decisiones y repetir bloques de código.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"E39Gw8S7tI"}],"key":"A0uH4BFv9N"}],"identifier":"4434e2a7","html_id":"4434e2a7","key":"QcAWR1Wk45"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"edad = 20\nif edad >= 18:\n    print(\"Mayor de edad\")\nelif edad > 12:\n    print(\"Adolescente\")\nelse:\n    print(\"Niño\")\n\n# Bucle For\nfor i in range(3):\n    print(\"Iteración for:\", i)\n\n# Bucle While con control\ncontador = 0\nwhile contador < 3:\n    if contador == 1:\n        contador += 1\n        continue\n    print(\"Contador while:\", contador)\n    contador += 1","key":"HEZxGm60PV"},{"type":"outputs","id":"xVL3Jkiio5jc7LLJ8-5jR","children":[],"key":"z1yof7jN8k"}],"identifier":"7bfc6d5a","html_id":"7bfc6d5a","key":"SEv6j7Vucb"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Funciones y Argumentos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NBnL9hqhmx"}],"identifier":"id-5-funciones-y-argumentos","label":"5. Funciones y Argumentos","html_id":"id-5-funciones-y-argumentos","implicit":true,"key":"LlQaqvq18f"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Las funciones se definen con ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"X85VeTrBPF"},{"type":"inlineCode","value":"def","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Rh6WJHiyy5"},{"type":"text","value":" y pueden recibir argumentos posicionales, nombrados, ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LQlpjitVmP"},{"type":"inlineCode","value":"*args","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XxiBHa86gy"},{"type":"text","value":" y ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Twpz7QLMw7"},{"type":"inlineCode","value":"**kwargs","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"s3pf9MONT3"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TH8VHFDwoz"}],"key":"WF4hfQgiac"}],"identifier":"9fb70963","html_id":"9fb70963","key":"s1wmaT8e0D"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def sumar_todo(*args, **kwargs):\n    total = sum(args)\n    print(\"Argumentos extra:\", kwargs)\n    return total\n\nresultado = sumar_todo(1, 2, 3, 4, operacion=\"suma\")\nprint(\"Resultado:\", resultado)","key":"reoupHOONz"},{"type":"outputs","id":"cSf0MPl4cBwje7hU-GQ3M","children":[],"key":"AzATClO0NK"}],"identifier":"1de87e6c","html_id":"1de87e6c","key":"xpj3WEkCgW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Módulos, Excepciones y Manejo de Archivos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vfX0F6lweY"}],"identifier":"id-6-m-dulos-excepciones-y-manejo-de-archivos","label":"6. Módulos, Excepciones y Manejo de Archivos","html_id":"id-6-m-dulos-excepciones-y-manejo-de-archivos","implicit":true,"key":"U3niCZ7ZB9"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Importación de módulos, bloques try-except-finally y lectura/escritura de archivos.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Dblp7GC6Yk"}],"key":"F1fWH2zvX5"}],"identifier":"e90a7cbf","html_id":"e90a7cbf","key":"j9NDKGGUDl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import math\n\nprint(\"Raíz cuadrada de 16:\", math.sqrt(16))\n\ntry:\n    resultado = 10 / 0\nexcept ZeroDivisionError:\n    print(\"Error: División por cero\")\nfinally:\n    print(\"Bloque finally ejecutado\")\n\n# Manejo de archivos (crear y leer)\nwith open(\"test.txt\", \"w\") as f:\n    f.write(\"Hola mundo desde un archivo en Python\")\n\nwith open(\"test.txt\", \"r\") as f:\n    contenido = f.read()\n    print(\"Contenido del archivo:\", contenido)","key":"M5t1eC5pad"},{"type":"outputs","id":"BPHHeb6ns6cUfamQGF9dB","children":[],"key":"I3FLpftuIm"}],"identifier":"877dd4b9","html_id":"877dd4b9","key":"k4n2wJc7OT"}],"key":"RLKBIWlhiU"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Flujo de Trabajo del Analista de Datos (Data Analyst Workflow)","url":"/class02","group":"Módulo 1 - FUNDAMENTOS"},"next":{"title":"Introducción a NumPy","url":"/numpy","group":"Módulo 1 - FUNDAMENTOS"}}},"domain":"http://pre.render"}