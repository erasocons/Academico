 posicionales, nombrados, ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XYhlIIyhUX"},{"type":"inlineCode","value":"*args","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iHKpPRA7ar"},{"type":"text","value":" y ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Ohq34QCpNr"},{"type":"inlineCode","value":"**kwargs","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hbI0NX9keN"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PvMFbT9Py6"}],"key":"F505TwHYgJ"}],"identifier":"9fb70963","html_id":"9fb70963","key":"qS0XilwiVH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def sumar_todo(*args, **kwargs):\n    total = sum(args)\n    print(\"Argumentos extra:\", kwargs)\n    return total\n\nresultado = sumar_todo(1, 2, 3, 4, operacion=\"suma\")\nprint(\"Resultado:\", resultado)","key":"djfiC0Ru6S"},{"type":"outputs","id":"TedtnmeTt-yrniQ35uHMC","children":[],"key":"WKVDh0hRim"}],"identifier":"1de87e6c","html_id":"1de87e6c","key":"pjlqOkN1FB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Módulos, Excepciones y Manejo de Archivos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SXIKtMQGBI"}],"identifier":"id-6-m-dulos-excepciones-y-manejo-de-archivos","label":"6. Módulos, Excepciones y Manejo de Archivos","html_id":"id-6-m-dulos-excepciones-y-manejo-de-archivos","implicit":true,"key":"QiSlSnJJ8C"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Importación de módulos, bloques try-except-finally y lectura/escritura de archivos.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wWFc7v6TO9"}],"key":"rTU7Z5mlQv"}],"identifier":"e90a7cbf","html_id":"e90a7cbf","key":"vv2Iy4uYRK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import math\n\nprint(\"Raíz cuadrada de 16:\", math.sqrt(16))\n\ntry:\n    resultado = 10 / 0\nexcept ZeroDivisionError:\n    print(\"Error: División por cero\")\nfinally:\n    print(\"Bloque finally ejecutado\")\n\n# Manejo de archivos (crear y leer)\nwith open(\"test.txt\", \"w\") as f:\n    f.write(\"Hola mundo desde un archivo en Python\")\n\nwith open(\"test.txt\", \"r\") as f:\n    contenido = f.read()\n    print(\"Contenido del archivo:\", contenido)","key":"F3iM1PD2VR"},{"type":"outputs","id":"2Z2L8ImSTx91KDaqYRHOj","children":[],"key":"Mvo1aML2uH"}],"identifier":"877dd4b9","html_id":"877dd4b9","key":"hKfKEPIsw5"}],"key":"NrmIlaYHCG"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CLASE01: El Poder de la Analítica de Datos","url":"/class01","group":"Módulo 1 - FUNDAMENTOS"}}},"domain":"http://localhost:3000"}