{"version":3,"kind":"Notebook","sha256":"4f832a9fc541e20fc47cfb614b788a57a2e20af47523cb8032f7447dc0b521f0","slug":"sql-intermedio","location":"/content/SQL_intermedio.ipynb","dependencies":[],"frontmatter":{"title":"SQL Intermedio: Agregaciones, Joins y Subconsultas","content_includes_title":false,"authors":[{"id":"Diego Eraso","name":"Diego Eraso"}],"keywords":["data-analytics","python","jupyter"],"numbering":{"title":{"offset":2}},"exports":[{"format":"ipynb","filename":"SQL_intermedio.ipynb","url":"/Academico//build/SQL_intermedio-f75d0fe2e8390489b842eb4fd07695fe.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"En este cuaderno exploraremos conceptos intermedios de SQL utilizando Python y la librería ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"RoN9LoT54E"},{"type":"inlineCode","value":"sqlite3","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EM3J3jZhz3"},{"type":"text","value":" junto con ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TFMiKTWgjE"},{"type":"inlineCode","value":"pandas","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZrgQX76LtM"},{"type":"text","value":" para visualizar los resultados.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tHiYwwOLiT"}],"key":"ov6ED3t3uT"}],"identifier":"c34336cf","html_id":"c34336cf","key":"XMJebtEWIG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import sqlite3\nimport pandas as pd\n\n# Crear una base de datos en memoria para el ejemplo\nconn = sqlite3.connect(':memory:')\ncursor = conn.cursor()\n\n# Crear tablas de ejemplo: empleados y departamentos\ncursor.execute('''\nCREATE TABLE departamentos (\n    id INTEGER PRIMARY KEY,\n    nombre TEXT\n);\n''')\n\ncursor.execute('''\nCREATE TABLE empleados (\n    id INTEGER PRIMARY KEY,\n    nombre TEXT,\n    departamento_id INTEGER,\n    salario REAL,\n    FOREIGN KEY (departamento_id) REFERENCES departamentos (id)\n);\n''')\n\n# Insertar datos\ncursor.executemany('INSERT INTO departamentos VALUES (?, ?)', [\n    (1, 'Ventas'),\n    (2, 'IT'),\n    (3, 'Recursos Humanos'),\n    (4, 'Marketing')\n])\n\ncursor.executemany('INSERT INTO empleados VALUES (?, ?, ?, ?)', [\n    (1, 'Ana', 1, 3000),\n    (2, 'Luis', 1, 3500),\n    (3, 'Carlos', 2, 5000),\n    (4, 'Sofia', 2, 6000),\n    (5, 'Marta', 3, 2500),\n    (6, 'Pedro', None, 2000)\n])\n\nconn.commit()","key":"lQqRbQDFBt"},{"type":"outputs","id":"Hq068XaxZlF9G3_tgKj5Z","children":[],"key":"qVFE21pCXc"}],"identifier":"7c726f22","html_id":"7c726f22","key":"uC7XwDst67"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"09. Funciones de Agregación (Aggregate Functions)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JLg4ryqjTJ"}],"identifier":"id-09-funciones-de-agregaci-n-aggregate-functions","label":"09. Funciones de Agregación (Aggregate Functions)","html_id":"id-09-funciones-de-agregaci-n-aggregate-functions","implicit":true,"key":"G1FVMtc83Y"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Las funciones de agregación realizan un cálculo sobre un conjunto de valores y devuelven un solo valor (COUNT, SUM, AVG, MAX, MIN).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"SiGFs9KwOO"}],"key":"OKPz285CeW"}],"identifier":"94f3a7c4","html_id":"94f3a7c4","key":"ejeYAYyWeE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    COUNT(*) AS total_empleados,\n    SUM(salario) AS salario_total,\n    AVG(salario) AS salario_promedio,\n    MAX(salario) AS salario_maximo,\n    MIN(salario) AS salario_minimo\nFROM empleados;\n'''\npd.read_sql_query(query, conn)","key":"tJMQz6as9T"},{"type":"outputs","id":"X2dopYbJ69X_7cK05xsi-","children":[],"key":"fJoXEtas1O"}],"identifier":"c59d7965","html_id":"c59d7965","key":"BFjBoNbUFN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"10. GROUP BY","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HSmhSqO6O5"}],"identifier":"id-10-group-by","label":"10. GROUP BY","html_id":"id-10-group-by","implicit":true,"key":"L3vmrW32GK"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Permite agrupar filas que comparten un mismo valor en columnas específicas para aplicar funciones de agregación a cada grupo.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"vb1GOe7Q4o"}],"key":"bAMEVwUPMe"}],"identifier":"f71a8222","html_id":"f71a8222","key":"Sr2Y5yxPNA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    departamento_id,\n    COUNT(*) AS num_empleados,\n    AVG(salario) AS salario_promedio\nFROM empleados\nGROUP BY departamento_id;\n'''\npd.read_sql_query(query, conn)","key":"Vms29ulh73"},{"type":"outputs","id":"sc-Bwd577NQVOBS4411W_","children":[],"key":"eavxuNQ6IQ"}],"identifier":"7388a890","html_id":"7388a890","key":"vhjAxmHaBb"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"11. HAVING","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sSgE7kqbFY"}],"identifier":"id-11-having","label":"11. HAVING","html_id":"id-11-having","implicit":true,"key":"kExd79nMDZ"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Se utiliza para filtrar los resultados agrupados (similar a WHERE, pero operando sobre funciones de agregación).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"acepBkWxpS"}],"key":"SHATZU6WS9"}],"identifier":"1d2daa40","html_id":"1d2daa40","key":"SblxCZz1vB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    departamento_id,\n    AVG(salario) AS salario_promedio\nFROM empleados\nGROUP BY departamento_id\nHAVING AVG(salario) > 3000;\n'''\npd.read_sql_query(query, conn)","key":"dowBwZyh60"},{"type":"outputs","id":"-_-c5v1M-BOeskg_Fzv2H","children":[],"key":"IdoSAs46gG"}],"identifier":"3579e56e","html_id":"3579e56e","key":"BPXTqHYuhe"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"12. INNER JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qoJSj6mmfb"}],"identifier":"id-12-inner-join","label":"12. INNER JOIN","html_id":"id-12-inner-join","implicit":true,"key":"rXFNTKVoRT"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Devuelve registros que tienen valores coincidentes en ambas tablas.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"JGj4GtTs5m"}],"key":"HK4CJSkA3l"}],"identifier":"6578a505","html_id":"6578a505","key":"x4ABVhAPk4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    e.nombre AS empleado,\n    d.nombre AS departamento\nFROM empleados e\nINNER JOIN departamentos d \n    ON e.departamento_id = d.id;\n'''\npd.read_sql_query(query, conn)","key":"ZK1GuHz1wW"},{"type":"outputs","id":"2tEh5yRSOv1skMXP1Ywml","children":[],"key":"AMmYcr8DTN"}],"identifier":"3b8f0233","html_id":"3b8f0233","key":"vEmFhXFbTl"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"13. LEFT JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MdNTZb47oE"}],"identifier":"id-13-left-join","label":"13. LEFT JOIN","html_id":"id-13-left-join","implicit":true,"key":"KaZoJLjEHg"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Devuelve todos los registros de la tabla izquierda, y los registros coincidentes de la tabla derecha.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"vczYQerKVG"}],"key":"iw2nNxqMeo"}],"identifier":"cf5907cc","html_id":"cf5907cc","key":"v7hwHyVxa2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    e.nombre AS empleado,\n    d.nombre AS departamento\nFROM empleados e\nLEFT JOIN departamentos d \n    ON e.departamento_id = d.id;\n'''\npd.read_sql_query(query, conn)","key":"ii3IvHkdKr"},{"type":"outputs","id":"dppyxfZbPxpZhXl9JUNst","children":[],"key":"O8OTiqJLhZ"}],"identifier":"38f8aa2d","html_id":"38f8aa2d","key":"i0IpVBtawL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"14. RIGHT JOIN y FULL JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NtecOxzuiM"}],"identifier":"id-14-right-join-y-full-join","label":"14. RIGHT JOIN y FULL JOIN","html_id":"id-14-right-join-y-full-join","implicit":true,"key":"x2zNa4H16S"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Nota: SQLite no soporta directamente RIGHT JOIN ni FULL OUTER JOIN, pero se pueden emular con UNION o invirtiendo las tablas en un LEFT JOIN.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"vUfD1ogucc"}],"key":"ukdLaeXcnb"}],"identifier":"66da9f5f","html_id":"66da9f5f","key":"F0FQYYtvZS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Emulando RIGHT JOIN invirtiendo la lógica con LEFT JOIN\nquery = '''\nSELECT \n    e.nombre AS empleado,\n    d.nombre AS departamento\nFROM departamentos d\nLEFT JOIN empleados e \n    ON e.departamento_id = d.id;\n'''\npd.read_sql_query(query, conn)","key":"MKJ4beCiVg"},{"type":"outputs","id":"S-DTTWyWZtlDhg7efsApJ","children":[],"key":"imwsZbUCI7"}],"identifier":"89d4ff99","html_id":"89d4ff99","key":"UJtKXi4R19"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"15. SELF JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PZTQIqYaK0"}],"identifier":"id-15-self-join","label":"15. SELF JOIN","html_id":"id-15-self-join","implicit":true,"key":"BFsPxGsjNH"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Es una unión regular donde una tabla se une a sí misma.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"b7Lh7khHTe"}],"key":"uMYuPWF37t"}],"identifier":"4e904b88","html_id":"4e904b88","key":"x0Xc5CUVwu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Ejemplo teórico creando una relación de compañeros en el mismo departamento\nquery = '''\nSELECT \n    e1.nombre AS empleado1,\n    e2.nombre AS empleado2,\n    e1.departamento_id\nFROM empleados e1\nJOIN empleados e2 \n    ON e1.departamento_id = e2.departamento_id \n    AND e1.id < e2.id;\n'''\npd.read_sql_query(query, conn)","key":"kTDglLrkK9"},{"type":"outputs","id":"hbQY1PiMzXu47wTAugGj4","children":[],"key":"QKaWlMnuLf"}],"identifier":"81046ca6","html_id":"81046ca6","key":"wmN3QaNvl8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"16. Subconsultas (Subqueries)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WcdwICWMOw"}],"identifier":"id-16-subconsultas-subqueries","label":"16. Subconsultas (Subqueries)","html_id":"id-16-subconsultas-subqueries","implicit":true,"key":"O0isbHYYES"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Una consulta dentro de otra consulta.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"SIpgR5huzq"}],"key":"Vj29EzPpyY"}],"identifier":"d85997b9","html_id":"d85997b9","key":"jpLtSNayuV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT nombre, salario\nFROM empleados\nWHERE salario > (\n    SELECT AVG(salario) FROM empleados\n);\n'''\npd.read_sql_query(query, conn)","key":"xSS23u8EeF"},{"type":"outputs","id":"3WOd7uB4Cmri0Fib5aTOv","children":[],"key":"zLnndHYIEF"}],"identifier":"d60aedf6","html_id":"d60aedf6","key":"x0KIFpRbfx"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"17. CTEs (Common Table Expressions)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Pdsl3N99rr"}],"identifier":"id-17-ctes-common-table-expressions","label":"17. CTEs (Common Table Expressions)","html_id":"id-17-ctes-common-table-expressions","implicit":true,"key":"hrEWCq671q"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Las CTEs proporcionan un conjunto de resultados temporal con nombre que se puede referenciar dentro de una sentencia SELECT, INSERT, UPDATE o DELETE.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"TstW7L7S5X"}],"key":"v2yycmCl11"}],"identifier":"8802a0c5","html_id":"8802a0c5","key":"lEKcgHy1E4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nWITH PromedioSalarios AS (\n    SELECT departamento_id, AVG(salario) as promedio\n    FROM empleados\n    GROUP BY departamento_id\n)\nSELECT \n    e.nombre,\n    e.salario,\n    p.promedio\nFROM empleados e\nJOIN PromedioSalarios p \n    ON e.departamento_id = p.departamento_id\nWHERE e.salario > p.promedio;\n'''\npd.read_sql_query(query, conn)","key":"kHNUsioP2P"},{"type":"outputs","id":"T5kWK1KeFYym0aeeND8Tm","children":[],"key":"SfEmRJXm6r"}],"identifier":"f595c74d","html_id":"f595c74d","key":"MBBluylj0p"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Cerrar la conexión\nconn.close()","key":"a3vWm67Jvo"},{"type":"outputs","id":"UgTzNbuYExf1t_OfT3jv2","children":[],"key":"zqn1ACbZtF"}],"identifier":"fb5aee38","html_id":"fb5aee38","key":"cBeTnnhBv2"}],"key":"TqV8B4eP0V"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Introducción a SQL","url":"/sql-basico","group":"Módulo 1 - FUNDAMENTOS"},"next":{"title":"SQL Avanzado: Análisis de Datos y Window Functions","url":"/sql-avanzado","group":"Módulo 1 - FUNDAMENTOS"}}},"domain":"http://localhost:3000"}