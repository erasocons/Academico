yf"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Estandarización (StandardScaler).","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"WcYiXcjIir"}],"key":"iSh7RNL12z"}],"key":"yE8YcTUTtf"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Transformación Robusta (RobustScaler).","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"iDjfmYsXC9"}],"key":"qX9ghNs3oR"}],"key":"VLCZF7JGOZ"}],"key":"UPBs0myzs5"}],"identifier":"db74e0fb","html_id":"db74e0fb","key":"yut5ZDT8jU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom sklearn.preprocessing import MinMaxScaler, StandardScaler, RobustScaler, PowerTransformer\n\n# Configuración de estilo\nsns.set_theme(style=\"whitegrid\")","key":"gqUjUNVWoN"},{"type":"outputs","id":"0q6MtaN_s9YCJA4QF_ZYF","children":[],"key":"CaLWNbR8dW"}],"identifier":"1ecf1694","html_id":"1ecf1694","key":"WBdKIyeTvb"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Generación de un Dataset Sintético","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oRYfaQT6JP"}],"identifier":"id-1-generaci-n-de-un-dataset-sint-tico","label":"1. Generación de un Dataset Sintético","html_id":"id-1-generaci-n-de-un-dataset-sint-tico","implicit":true,"key":"JJqjpkBFv0"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Crearemos un conjunto de datos que simule variables con diferentes escalas y distribuciones sesgadas.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KTOh3dTtFY"}],"key":"Kp0r7MLvB6"}],"identifier":"3df62ba3","html_id":"3df62ba3","key":"L6wxA9tIoD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"np.random.seed(42)\nn = 1000\n\n# Variable con sesgo positivo (exponencial)\nincome = np.random.exponential(scale=20000, size=n) + 15000\n\n# Variable con distribución normal estándar\nage = np.random.normal(loc=35, scale=10, size=n)\n\n# Variable con outliers\nscore = np.random.normal(loc=500, scale=50, size=n)\nscore[0:10] = score[0:10] * 3  # Añadir outliers extremos\n\ndf = pd.DataFrame({\n    'Income': income,\n    'Age': age,\n    'Score': score\n})\n\ndf.head()","key":"lHcTNzPxaS"},{"type":"outputs","id":"IYAIkacCE2A7onalVm2t2","children":[],"key":"AQhxFM87fA"}],"identifier":"8b5bac76","html_id":"8b5bac76","key":"RcVRjtkOU6"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualicemos las distribuciones originales de nuestros datos.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wBcxbVNUPC"}],"key":"be868gmEll"}],"identifier":"c0b5d916","html_id":"c0b5d916","key":"pxquYaQTEC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plt.figure(figsize=(15, 4))\nfor i, col in enumerate(df.columns):\n    plt.subplot(1, 3, i + 1)\n    sns.histplot(df[col], kde=True, color='skyblue')\n    plt.title(f'Distribución Original: {col}')\nplt.tight_layout()\nplt.show()","key":"IfvDXdSrMn"},{"type":"outputs","id":"vPay6JbsqAbAWQjpSwhnO","children":[],"key":"U1KMfXfskQ"}],"identifier":"7039830f","html_id":"7039830f","key":"ACYp9nF857"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Corrección de Asimetría (Skewness)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QJrR0jG8Zz"}],"identifier":"id-2-correcci-n-de-asimetr-a-skewness","label":"2. Corrección de Asimetría (Skewness)","html_id":"id-2-correcci-n-de-asimetr-a-skewness","implicit":true,"key":"WstQ6kcnsv"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"La variable ‘Income’ presenta un claro sesgo positivo. Aplicaremos una transformación logarítmica y una transformación de Box-Cox para hacerla más simétrica.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"azkqhDa9BF"}],"key":"RTS4QiP9Ta"}],"identifier":"ecdc9c59","html_id":"ecdc9c59","key":"GBEAoOdjtz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"df['Income_Log'] = np.log1p(df['Income'])\n\npt = PowerTransformer(method='box-cox')\ndf['Income_BoxCox'] = pt.fit_transform(df[['Income']])\n\nplt.figure(figsize=(15, 4))\nplt.subplot(1, 3, 1)\nsns.histplot(df['Income'], kde=True, color='red')\nplt.title('Original Income')\n\nplt.subplot(1, 3, 2)\nsns.histplot(df['Income_Log'], kde=True, color='green')\nplt.title('Log Transform')\n\nplt.subplot(1, 3, 3)\nsns.histplot(df['Income_BoxCox'], kde=True, color='purple')\nplt.title('Box-Cox Transform')\n\nplt.tight_layout()\nplt.show()","key":"YaLqX14MWP"},{"type":"outputs","id":"-j6vuUSq2Q2f_BDrk6FrU","children":[],"key":"F92FcM42x4"}],"identifier":"08a66e1d","html_id":"08a66e1d","key":"eOSpw37fBK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Escalado y Normalización","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aSCXNQX3Oe"}],"identifier":"id-3-escalado-y-normalizaci-n","label":"3. Escalado y Normalización","html_id":"id-3-escalado-y-normalizaci-n","implicit":true,"key":"lSRdY2SthB"},{"type":"heading","depth":3,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"A. MinMaxScaler (Normalización)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JE2T5ZFetK"}],"identifier":"a-minmaxscaler-normalizaci-n","label":"A. MinMaxScaler (Normalización)","html_id":"a-minmaxscaler-normalizaci-n","implicit":true,"key":"hKWqSlzgiS"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Escala los datos a un rango específico, comúnmente entre 0 y 1.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"YCgValxuJ8"}],"key":"PVEG74z6Av"}],"identifier":"1c113310","html_id":"1c113310","key":"pNAPZtuXGK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"min_max_scaler = MinMaxScaler()\ndf_minmax = pd.DataFrame(\n    min_max_scaler.fit_transform(df[['Age', 'Score']]),\n    columns=['Age_MinMax', 'Score_MinMax']\n)\ndf_minmax.describe()","key":"Wn7pMVDrit"},{"type":"outputs","id":"-GmjfrcT4maeWNdlOGVtn","children":[],"key":"vX3AKrPSlM"}],"identifier":"db62c848","html_id":"db62c848","key":"r4qAisedGZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"B. StandardScaler (Estandarización)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"w5VrdHgRC9"}],"identifier":"b-standardscaler-estandarizaci-n","label":"B. StandardScaler (Estandarización)","html_id":"b-standardscaler-estandarizaci-n","implicit":true,"key":"WcxUX8BNMw"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}