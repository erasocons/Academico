"}],"identifier":"id-4-limpieza-y-conversi-n-de-tipos-de-datos","label":"4. Limpieza y Conversión de Tipos de Datos","html_id":"id-4-limpieza-y-conversi-n-de-tipos-de-datos","implicit":true,"key":"cy7gFRksgr"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Observamos que la columna ‘salario’ contiene símbolos de moneda y está en formato de texto. La columna ‘fecha_ingreso’ tiene un valor inválido.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"oC8bLnXxYD"}],"key":"FeVtCptkmg"}],"identifier":"cbc4c62a","html_id":"cbc4c62a","key":"QkLMxVDt1r"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Limpiar la columna salario eliminando el signo '$'\ndf['salario'] = df['salario'].str.replace('$', '', regex=True)\ndf['salario'] = pd.to_numeric(df['salario'], errors='coerce')\n\n# Convertir fecha_ingreso a datetime, forzando errores a NaT\ndf['fecha_ingreso'] = pd.to_datetime(df['fecha_ingreso'], errors='coerce')\n\ndf.dtypes","key":"jEsmwUwIR4"},{"type":"outputs","id":"b0JXSdgV_337wWZY_zh4O","children":[],"key":"DAfe4S4M7M"}],"identifier":"ff2a17d7","html_id":"ff2a17d7","key":"oKgefnWvAf"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Tratamiento de Valores Faltantes (Missing Values)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tCyZzUyISi"}],"identifier":"id-5-tratamiento-de-valores-faltantes-missing-values","label":"5. Tratamiento de Valores Faltantes (Missing Values)","html_id":"id-5-tratamiento-de-valores-faltantes-missing-values","implicit":true,"key":"ZprcygLYeX"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Analizamos cuántos valores faltantes