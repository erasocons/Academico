-4-estructuras-de-control-condicionales-y-bucles","implicit":true,"key":"kR8BY0dFFk"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Permiten tomar decisiones y repetir bloques de código.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tQwsWJiNpK"}],"key":"wWmoKOF3Ud"}],"identifier":"4434e2a7","html_id":"4434e2a7","key":"lMXIMxiBIy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"edad = 20\nif edad >= 18:\n    print(\"Mayor de edad\")\nelif edad > 12:\n    print(\"Adolescente\")\nelse:\n    print(\"Niño\")\n\n# Bucle For\nfor i in range(3):\n    print(\"Iteración for:\", i)\n\n# Bucle While con control\ncontador = 0\nwhile contador < 3:\n    if contador == 1:\n        contador += 1\n        continue\n    print(\"Contador while:\", contador)\n    contador += 1","key":"F3Fg47awpW"},{"type":"outputs","id":"DbNOVnqDD0Ca7ToowWMqH","children":[],"key":"ASadWbLq3t"}],"identifier":"7bfc6d5a","html_id":"7bfc6d5a","key":"VBtBmWJUTW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Funciones y Argumentos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LSJ7V8TCWE"}],"identifier":"id-5-funciones-y-argumentos","label":"5. Funciones y Argumentos","html_id":"id-5-funciones-y-argumentos","implicit":true,"key":"CkkVabeZgY"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Las funciones se definen con ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Od9crtxMYI"},{"type":"inlineCode","value":"def","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LlN9NVqagX"},{"type":"text","value":" y pueden recibir argumentos posicionales, nombrados, ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zM2cKGc8lk"},{"type":"inlineCode","value":"*args","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Z6bo97ryMc"},{"type":"text","value":" y ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"l3gJfEXhXM"},{"type":"inlineCode","value":"**kwargs","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Djf6n4nLP3"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PObaZO4sC1"}],"key":"azBEE6BnsW"}],"identifier":"9fb70963","html_id":"9fb70963","key":"l9ty7kN5MA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def sumar_todo(*args, **kwargs):\n    total = sum(args)\n    print(\"Argumentos extra:\", kwargs)\n    return total\n\nresultado = sumar_todo(1, 2, 3, 4, operacion=\"suma\")\nprint(\"Resultado:\", resultado)","key":"rYeeKEb850"},{"type":"outputs","id":"KGI73bv3DlJ5d8MQYcTVT","children":[],"key":"y0ZouYp4Fs"}],"identifier":"1de87e6c","html_id":"1de87e6c","key":"hTdd8ypDKQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Módulos, Excepciones y Manejo de Archivos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"o5yDV0hYyq"}],"identifier":"id-6-m-dulos-excepciones-y-manejo-de-archivos","label":"6. Módulos, Excepciones y Manejo de Archivos","html_id":"id-6-m-dulos-excepciones-y-manejo-de-archivos","implicit":true,"key":"DxrGpQzVLL"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Importación de módulos, bloques try-except-finally y lectura/escritura de archivos.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"m8DRNt6LqE"}],"key":"OnRi1w2hY0"}],"identifier":"e90a7cbf","html_id":"e90a7cbf","key":"moJZxuBv03"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import math\n\nprint(\"Raíz cuadrada de 16:\", math.sqrt(16))\n\ntry:\n    resultado = 10 / 0\nexcept ZeroDivisionError:\n    print(\"Error: División por cero\")\nfinally:\n    print(\"Bloque finally ejecutado\")\n\n# Manejo de archivos (crear y leer)\nwith open(\"test.txt\", \"w\") as f:\n    f.write(\"Hola mundo desde un archivo en Python\")\n\nwith open(\"test.txt\", \"r\") as f:\n    contenido = f.read()\n    print(\"Contenido del archivo:\", contenido)","key":"u54q992l1U"},{"type":"outputs","id":"0r-kj4g1yCEhTIIeZz3mT","children":[],"key":"NgryIHjStX"}],"identifier":"877dd4b9","html_id":"877dd4b9","key":"HYs3Vdyly0"}],"key":"KaFPxbD9lM"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Flujo de Trabajo del Analista de Datos (Data Analyst Workflow)","url":"/class02","group":"Módulo 1 - FUNDAMENTOS"},"next":{"title":"Introducción a NumPy","url":"/numpy","group":"Módulo 1 - FUNDAMENTOS"}}},"domain":"http://pre.render"}