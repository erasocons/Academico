 \"Ropa\", \"Hogar\", \"Deportes\"], n_filas),\n    \"Cantidad\": np.random.randint(1, 10, n_filas),\n    \"Precio_Unitario\": np.round(np.random.uniform(10.0, 500.0, n_filas), 2),\n    \"Region\": np.random.choice([\"Norte\", \"Sur\", \"Este\", \"Oeste\"], n_filas)\n}\n\ndf = pd.DataFrame(data)\n\n# Introducimos algunos valores nulos artificialmente para practicar la limpieza\ndf.loc[df[\"Cantidad\"].sample(10, random_state=42).index, \"Cantidad\"] = np.nan\n\n# Visualizamos las primeras filas\ndf.head()","key":"fgv3lg7kLZ"},{"type":"outputs","id":"ixKzwuFqbSZQhXB3wbV4L","children":[],"key":"q6433vd0GV"}],"identifier":"3ed292bc","html_id":"3ed292bc","key":"wlhwzgzuOr"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Limpieza y Preparación de Datos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DglmHSAlCW"}],"identifier":"id-3-limpieza-y-preparaci-n-de-datos","label":"3. Limpieza y Preparación de Datos","html_id":"id-3-limpieza-y-preparaci-n-de-datos","implicit":true,"key":"cR9IU9cdXo"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Revisamos la estructura del DataFrame, identificamos valores faltantes y aplicamos las transformaciones necesarias.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IFMsmAFbkh"}],"key":"oldBVG3C08"}],"identifier":"fd2b71eb","html_id":"fd2b71eb","key":"zmfDQVVC6K"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Información general del DataFrame\nprint(df.info())","key":"zX7QZ0StFd"},{"type":"outputs","id":"G9GB3tiZfyWmi-lubZETq","children":[],"key":"q5Jj5pSuXO"}],"identifier":"16a875ed","html_id":"16a875ed","key":"JDoqvsAVoL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Rellenamos los valores nulos de 'Cantidad' con la mediana de la columna\nmediana_cantidad = df[\"Cantidad\"].median()\ndf[\"Cantidad\"].fillna(mediana_cantidad, inplace=True)\n\n# Creamos una nueva columna calculada: 'Venta_Total'\ndf[\"Venta_Total\"] = df[\"Cantidad\"] * df[\"Precio_Unitario\"]\n\n# Verificamos que no queden nulos\nprint(df.isnull().sum())","key":"GVPW4v0yz6"},{"type":"outputs","id":"22tR2XQ_QOyx0ZoLePGAi","children":[],"key":"DZGGtDx8Uo"}],"identifier":"0b44df05","html_id":"0b44df05","key":"el6b9zXLQW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Análisis Exploratorio de Datos (EDA)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tQpnDLucaT"}],"identifier":"id-4-an-lisis-exploratorio-de-datos-eda","label":"4. Análisis Exploratorio de Datos (EDA)","html_id":"id-4-an-lisis-exploratorio-de-datos-eda","implicit":true,"key":"ToNqv8FSqJ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Calculamos estadísticas descriptivas básicas para entender la distribución de las variables numéricas y categóricas.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IUlfyddlpf"}],"key":"r7U4PMDhXU"}],"identifier":"e713d01d","html_id":"e713d01d","key":"oxgr4x97s1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Estadísticas descriptivas\ndf.describe()","key":"ngqQEivinI"},{"type":"outputs","id":"f7wFIUmeVdDShL1xXQfaf","children":[],"key":"uD2JvHqW6o"}],"identifier":"92e3eef9","html_id":"92e3eef9","key":"cqDHvOt5YZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Ventas totales por categoría\nventas_por_categoria = df.groupby(\"Categoria\")[\"Venta_Total\"].sum().reset_index()\nprint(ventas_por_categoria)","key":"cIwS6bhkda"},{"type":"outputs","id":"fzi_879oSQ5ZsiXQyr7et","children":[],"key":"bUrfM6fhtb"}],"identifier":"09545ac5","html_id":"09545ac5","key":"zaaZGOvVg9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Visualización de Datos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"O78unnSyUa"}],"identifier":"id-5-visualizaci-n-de-datos","label":"5. Visualización de Datos","html_id":"id-5-visualizaci-n-de-datos","implicit":true,"key":"gtUgW31NUw"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Generamos gráficos para comunicar visualmente los resultados obtenidos del análisis.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"R0nMue16L1"}],"key":"T3BGcLxIc6"}],"identifier":"1721fccc","html_id":"1721fccc","key":"D23RKRmIDc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Gráfico de barras: Ventas Totales por Categoría\nplt.figure(figsize=(8, 5))\nsns.barplot(data=ventas_por_categoria, x=\"Categoria\", y=\"Venta_Total\", palette=\"Blues_d\")\nplt.title(\"Ventas Totales por Categoría de Producto\")\nplt.xlabel(\"Categoría\")\nplt.ylabel(\"Venta Total ($)\")\nplt.show()","key":"DRpa7VtraJ"},{"type":"outputs","id":"727mWgME1iwzxNJqWiHSo","children":[],"key":"xgreQnzFzu"}],"identifier":"cb41c51e","html_id":"cb41c51e","key":"s0HUerpmOl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Gráfico de cajas (Boxplot): Distribución de precios por región\nplt.figure(figsize=(8, 5))\nsns.boxplot(data=df, x=\"Region\", y=\"Precio_Unitario\", palette=\"Set2\")\nplt.title(\"Distribución de Precios Unitarios por Región\")\nplt.xlabel(\"Región\")\nplt.ylabel(\"Precio Unitario ($)\")\nplt.show()","key":"NXweElkbFi"},{"type":"outputs","id":"OzIr9zRb9Ibhm72bdIzBd","children":[],"key":"nnRpYHcm0T"}],"identifier":"a7f62062","html_id":"a7f62062","key":"EtZg8BxNe5"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"El analista de datos no solo dice qué pasó (eso es solo reportar), sino que investiga por qué pasó.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KXfs393CyZ"}],"key":"zCOS6iHtXR"}],"key":"KnxTbPW8Mw"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"En el mundo profesional, esta función se conoce técnicamente como Analítica Diagnóstica.🔍 ¿Cómo encuentra el analista las causas de algo?Para entenderlo de forma sencilla, el analista opera como un detective de datos a través de estos pasos:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Vap64302L0"}],"key":"PPKV8oPpo5"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"(El síntoma): El negocio nota un problema. Ejemplo: “Las ventas de la app cayeron un 20% este mes”.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"bxv34YkmPp"}],"key":"shreVFoTjD"}],"key":"GnehhH230g"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"(La investigación): El analista cruza variables, filtra fechas y compara segmentos.Paso","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"Ia75cPYqa1"}],"key":"C8PGakhqoW"}],"key":"tqiJFLun03"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"(La causa raíz): El analista encuentra el motivo real. Ejemplo: “La caída ocurrió solo en usuarios de Android después de la última actualización del día 5”.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"C7KQeVhsDo"}],"key":"ZIXxtJXsPx"}],"key":"Cfea130eWR"}],"key":"OC5s0b0VLo"}],"identifier":"90930cfd","html_id":"90930cfd","key":"lbjOefOOW0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Conclusiones","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"roOB8fCjGY"}],"identifier":"id-6-conclusiones","label":"6. Conclusiones","html_id":"id-6-conclusiones","implicit":true,"key":"OP54gaNYYE"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"El proceso de limpieza permitió corregir los valores faltantes sin perder registros valiosos.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VOC35CGVzo"}],"key":"GzxbBKGyr3"}],"key":"nsSc09XsG2"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"La categoría ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"bkSQWn0Bu4"},{"type":"strong",