OINCREMENT,\n    nombre TEXT NOT NULL,\n    departamento TEXT NOT NULL,\n    salario REAL\n)\n''')\n\n# Confirmar los cambios\nconexion.commit()","key":"jT8TUqKAkz"},{"type":"outputs","id":"vZHpfDAkS1U88-qmnrGo1","children":[],"key":"rJyh7WknSs"}],"identifier":"6ebf38c8","html_id":"6ebf38c8","key":"GbCisfHup8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Insertar datos en la tabla","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kYqE4pGzU4"}],"identifier":"id-4-insertar-datos-en-la-tabla","label":"4. Insertar datos en la tabla","html_id":"id-4-insertar-datos-en-la-tabla","implicit":true,"key":"D2IJ0XdbkU"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Añadiremos algunos registros de ejemplo para poder realizar consultas posteriormente.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zPudyAWRnC"}],"key":"rkOhz2sQNG"}],"identifier":"08b8e802","html_id":"08b8e802","key":"SYlgoKXsbO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Insertar datos de prueba\ndatos = [\n    ('Ana Pérez', 'Ventas', 3000),\n    ('Carlos Gómez', 'IT', 4500),\n    ('Elena Torres', 'Marketing', 3200),\n    ('David Ruiz', 'IT', 4800),\n    ('Sofía Castro', 'Ventas', 3100)\n]\n\ncursor.executemany('INSERT INTO empleados (nombre, departamento, salario) VALUES (?, ?, ?)', datos)\nconexion.commit()\n\nprint('Datos insertados exitosamente.')","key":"pDbvnaZLyc"},{"type":"outputs","id":"gLO9UhtGE6rwcUlfKHaob","children":[],"key":"x3V7JnKDi6"}],"identifier":"f44eae79","html_id":"f44eae79","key":"fTJoDPHtyn"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":