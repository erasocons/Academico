\"Ropa\", \"Hogar\", \"Deportes\"], n_filas),\n    \"Cantidad\": np.random.randint(1, 10, n_filas),\n    \"Precio_Unitario\": np.round(np.random.uniform(10.0, 500.0, n_filas), 2),\n    \"Region\": np.random.choice([\"Norte\", \"Sur\", \"Este\", \"Oeste\"], n_filas)\n}\n\ndf = pd.DataFrame(data)\n\n# Introducimos algunos valores nulos artificialmente para practicar la limpieza\ndf.loc[df[\"Cantidad\"].sample(10, random_state=42).index, \"Cantidad\"] = np.nan\n\n# Visualizamos las primeras filas\ndf.head()","key":"GYIJZ4KfiU"},{"type":"outputs","id":"6hphDEU8tCOL-nWcujEg7","children":[],"key":"xYAcCKkSjJ"}],"identifier":"3ed292bc","html_id":"3ed292bc","key":"Upb93msyO1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Limpieza y Preparación de Datos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EFLxMvdecu"}],"identifier":"id-3-limpieza-y-preparaci-n-de-datos","label":"3. Limpieza y Preparación de Datos","html_id":"id-3-limpieza-y-preparaci-n-de-datos","implicit":true,"key":"DDDxKSSSUR"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Revisamos la estructura del DataFrame, identificamos valores faltantes y aplicamos las transformaciones necesarias.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mA38RR917T"}],"key":"kdFCgPXEcE"}],"identifier":"fd2b71eb","html_id":"fd2b71eb","key":"D4YszNrxuU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Información general del DataFrame\nprint(df.info())","key":"Vue2So1INW"},{"type":"outputs","id":"dqNT7xChaY9RLpaIHDjk1","children":[],"key":"WImQvT460m"}],"identifier":"16a875ed","html_id":"16a875ed","key":"ZZnz0ersHn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lan