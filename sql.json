OINCREMENT,\n    nombre TEXT NOT NULL,\n    departamento TEXT NOT NULL,\n    salario REAL\n)\n''')\n\n# Confirmar los cambios\nconexion.commit()","key":"vwMl1SxyqG"},{"type":"outputs","id":"AhHWde5XvymghtXtV44BW","children":[],"key":"bqd9YIZcgo"}],"identifier":"6ebf38c8","html_id":"6ebf38c8","key":"s3zvaUDioy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Insertar datos en la tabla","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ARWpgpXblY"}],"identifier":"id-4-insertar-datos-en-la-tabla","label":"4. Insertar datos en la tabla","html_id":"id-4-insertar-datos-en-la-tabla","implicit":true,"key":"D1XLNQJl6b"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Añadiremos algunos registros de ejemplo para poder realizar consultas posteriormente.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZhGHAMFZAb"}],"key":"eeftkPoDs1"}],"identifier":"08b8e802","html_id":"08b8e802","key":"fJNEACRtKO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Insertar datos de prueba\ndatos = [\n    ('Ana Pérez', 'Ventas', 3000),\n    ('Carlos Gómez', 'IT', 4500),\n    ('Elena Torres', 'Marketing', 3200),\n    ('David Ruiz', 'IT', 4800),\n    ('Sofía Castro', 'Ventas', 3100)\n]\n\ncursor.executemany('INSERT INTO empleados (nombre, departamento, salario) VALUES (?, ?, ?)', datos)\nconexion.commit()\n\nprint('Datos insertados exitosamente.')","key":"AyP9gjmzZO"},{"type":"outputs","id":"eecxh3dLsVYLcMxRcotvA","children":[],"key":"SutToQf3WV"}],"identifier":"f44eae79","html_id":"f44eae79","key":"nXJrxxVxfa"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":