las 0 y 1, columnas 1 y 2)\nprint(arr[0:2, 1:])","key":"aNQELnz1v0"},{"type":"outputs","id":"rzYLCv57KcXcGurgf3hU-","children":[],"key":"DR74G22Pxg"}],"identifier":"8a0a6fe1","html_id":"8a0a6fe1","key":"Z5tOf4AFsG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"04 - Operaciones con Arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LHoF8L4hdI"}],"identifier":"id-04-operaciones-con-arrays","label":"04 - Operaciones con Arrays","html_id":"id-04-operaciones-con-arrays","implicit":true,"key":"M1rgMtyX2W"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Las operaciones aritméticas en arrays operan elemento por elemento (element-wise).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Asc4vqXMg1"}],"key":"mOtCJbIcKK"}],"identifier":"8ace741a","html_id":"8ace741a","key":"IwWEoiSEet"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"x = np.array([1, 2, 3])\ny = np.array([4, 5, 6])\n\n# Suma\nprint(x + y)\n\n# Multiplicación elemento a elemento\nprint(x * y)\n\n# Producto punto (dot product)\nprint(np.dot(x, y))","key":"DMhsyiMVcx"},{"type":"outputs","id":"x-jCJ_A9Kj9zzNSuo3kPB","children":[],"key":"MsoCZxhoAM"}],"identifier":"5b333a27","html_id":"5b333a27","key":"vbsiJXTBU5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"05 - Broadcasting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UxPXXymLAe"}],"identifier":"id-05-broadcasting","label":"05 - Broadcasting","html_id":"id-05-broadcasting","implicit":true,"key":"XeHVpyAiht"},{"type":"paragraph","position":{"start