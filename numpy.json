ilas 0 y 1, columnas 1 y 2)\nprint(arr[0:2, 1:])","key":"KjVjpDLhAq"},{"type":"outputs","id":"EqQGomH-owRpfZmMQgw2j","children":[],"key":"dYfLqTZ5yR"}],"identifier":"8a0a6fe1","html_id":"8a0a6fe1","key":"cHACGrMbeT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"04 - Operaciones con Arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KMvIDiTuEX"}],"identifier":"id-04-operaciones-con-arrays","label":"04 - Operaciones con Arrays","html_id":"id-04-operaciones-con-arrays","implicit":true,"key":"UlJnIppJU8"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Las operaciones aritméticas en arrays operan elemento por elemento (element-wise).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"W8DLldQzt5"}],"key":"qZIipFZoOf"}],"identifier":"8ace741a","html_id":"8ace741a","key":"anFpRxwx8R"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"x = np.array([1, 2, 3])\ny = np.array([4, 5, 6])\n\n# Suma\nprint(x + y)\n\n# Multiplicación elemento a elemento\nprint(x * y)\n\n# Producto punto (dot product)\nprint(np.dot(x, y))","key":"RLby5XtQki"},{"type":"outputs","id":"-msASOyr-5WZ1yOJLq2ni","children":[],"key":"lkb8PrsJih"}],"identifier":"5b333a27","html_id":"5b333a27","key":"O4a9f7tQEd"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"05 - Broadcasting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"coTJDlkPOz"}],"identifier":"id-05-broadcasting","label":"05 - Broadcasting","html_id":"id-05-broadcasting","implicit":true,"key":"ZfPS2uH42G"},{"type":"paragraph","position":{"star