{"version":3,"kind":"Notebook","sha256":"4f832a9fc541e20fc47cfb614b788a57a2e20af47523cb8032f7447dc0b521f0","slug":"sql-intermedio","location":"/content/SQL_intermedio.ipynb","dependencies":[],"frontmatter":{"title":"SQL Intermedio: Agregaciones, Joins y Subconsultas","content_includes_title":false,"authors":[{"id":"Diego Eraso","name":"Diego Eraso"}],"keywords":["data-analytics","python","jupyter"],"numbering":{"title":{"offset":2}},"exports":[{"format":"ipynb","filename":"SQL_intermedio.ipynb","url":"/Academico/_public/SQL_intermedio-b4b0f911365dd76c237dfb4541164ce5.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"En este cuaderno exploraremos conceptos intermedios de SQL utilizando Python y la librería ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rBGnhnMDNX"},{"type":"inlineCode","value":"sqlite3","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vRb8WLvj1P"},{"type":"text","value":" junto con ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Be0zIry1SB"},{"type":"inlineCode","value":"pandas","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sAD9wONSYO"},{"type":"text","value":" para visualizar los resultados.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YoKc1QeugS"}],"key":"xLeCG5dHBf"}],"identifier":"c34336cf","html_id":"c34336cf","key":"CWbYw49w72"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import sqlite3\nimport pandas as pd\n\n# Crear una base de datos en memoria para el ejemplo\nconn = sqlite3.connect(':memory:')\ncursor = conn.cursor()\n\n# Crear tablas de ejemplo: empleados y departamentos\ncursor.execute('''\nCREATE TABLE departamentos (\n    id INTEGER PRIMARY KEY,\n    nombre TEXT\n);\n''')\n\ncursor.execute('''\nCREATE TABLE empleados (\n    id INTEGER PRIMARY KEY,\n    nombre TEXT,\n    departamento_id INTEGER,\n    salario REAL,\n    FOREIGN KEY (departamento_id) REFERENCES departamentos (id)\n);\n''')\n\n# Insertar datos\ncursor.executemany('INSERT INTO departamentos VALUES (?, ?)', [\n    (1, 'Ventas'),\n    (2, 'IT'),\n    (3, 'Recursos Humanos'),\n    (4, 'Marketing')\n])\n\ncursor.executemany('INSERT INTO empleados VALUES (?, ?, ?, ?)', [\n    (1, 'Ana', 1, 3000),\n    (2, 'Luis', 1, 3500),\n    (3, 'Carlos', 2, 5000),\n    (4, 'Sofia', 2, 6000),\n    (5, 'Marta', 3, 2500),\n    (6, 'Pedro', None, 2000)\n])\n\nconn.commit()","key":"Q8nhdc2grs"},{"type":"outputs","id":"PBeOn1RK0W97x3czGYBoM","children":[],"key":"yCxLheucmh"}],"identifier":"7c726f22","html_id":"7c726f22","key":"aTuyrY0V3c"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"09. Funciones de Agregación (Aggregate Functions)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nyPDMgeITr"}],"identifier":"id-09-funciones-de-agregaci-n-aggregate-functions","label":"09. Funciones de Agregación (Aggregate Functions)","html_id":"id-09-funciones-de-agregaci-n-aggregate-functions","implicit":true,"key":"WX4AmOG9wY"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Las funciones de agregación realizan un cálculo sobre un conjunto de valores y devuelven un solo valor (COUNT, SUM, AVG, MAX, MIN).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"HL4bzjZVQP"}],"key":"JSdnN7FjkJ"}],"identifier":"94f3a7c4","html_id":"94f3a7c4","key":"FtBIUytoxh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    COUNT(*) AS total_empleados,\n    SUM(salario) AS salario_total,\n    AVG(salario) AS salario_promedio,\n    MAX(salario) AS salario_maximo,\n    MIN(salario) AS salario_minimo\nFROM empleados;\n'''\npd.read_sql_query(query, conn)","key":"FDRes0vDcD"},{"type":"outputs","id":"Yi-KfqP-Ssfnw0pTCPTYU","children":[],"key":"eX8CpnQ8cw"}],"identifier":"c59d7965","html_id":"c59d7965","key":"dp0DM4YdHq"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"10. GROUP BY","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YEKOFJ9xco"}],"identifier":"id-10-group-by","label":"10. GROUP BY","html_id":"id-10-group-by","implicit":true,"key":"am4I5OLFoo"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Permite agrupar filas que comparten un mismo valor en columnas específicas para aplicar funciones de agregación a cada grupo.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Nn3M26xiCO"}],"key":"itmVwzXlHj"}],"identifier":"f71a8222","html_id":"f71a8222","key":"puFnTbRVsB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    departamento_id,\n    COUNT(*) AS num_empleados,\n    AVG(salario) AS salario_promedio\nFROM empleados\nGROUP BY departamento_id;\n'''\npd.read_sql_query(query, conn)","key":"wOrokCW6GF"},{"type":"outputs","id":"TLkELNddi-m07xC1MRdNw","children":[],"key":"VCwWxtHh5e"}],"identifier":"7388a890","html_id":"7388a890","key":"MvhE3QH2U2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"11. HAVING","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NfuVirbHVM"}],"identifier":"id-11-having","label":"11. HAVING","html_id":"id-11-having","implicit":true,"key":"EitE73UQcz"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Se utiliza para filtrar los resultados agrupados (similar a WHERE, pero operando sobre funciones de agregación).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"IhWxg35R6U"}],"key":"MApCIe5OvS"}],"identifier":"1d2daa40","html_id":"1d2daa40","key":"nb8me4XwfW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    departamento_id,\n    AVG(salario) AS salario_promedio\nFROM empleados\nGROUP BY departamento_id\nHAVING AVG(salario) > 3000;\n'''\npd.read_sql_query(query, conn)","key":"e8861hrMQZ"},{"type":"outputs","id":"ZfksWBUh9WXUBP0vV7vli","children":[],"key":"DzdZRjTgnm"}],"identifier":"3579e56e","html_id":"3579e56e","key":"JUwLF9g1aK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"12. INNER JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"H02ZvSN6tp"}],"identifier":"id-12-inner-join","label":"12. INNER JOIN","html_id":"id-12-inner-join","implicit":true,"key":"iKADT8rY4s"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Devuelve registros que tienen valores coincidentes en ambas tablas.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"mYak5zAvGC"}],"key":"wRmVObA3iW"}],"identifier":"6578a505","html_id":"6578a505","key":"ADP0c95bz6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    e.nombre AS empleado,\n    d.nombre AS departamento\nFROM empleados e\nINNER JOIN departamentos d \n    ON e.departamento_id = d.id;\n'''\npd.read_sql_query(query, conn)","key":"IGEb7l8FEm"},{"type":"outputs","id":"GExXsVEvzlPSH2DJquh34","children":[],"key":"sT4L0WTAfz"}],"identifier":"3b8f0233","html_id":"3b8f0233","key":"rpS7ymKf57"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"13. LEFT JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"z50nO21m2F"}],"identifier":"id-13-left-join","label":"13. LEFT JOIN","html_id":"id-13-left-join","implicit":true,"key":"nRUEsumxD9"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Devuelve todos los registros de la tabla izquierda, y los registros coincidentes de la tabla derecha.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"udqe17Yd8O"}],"key":"ch1dhoY6lt"}],"identifier":"cf5907cc","html_id":"cf5907cc","key":"NzHEkUY1FE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT \n    e.nombre AS empleado,\n    d.nombre AS departamento\nFROM empleados e\nLEFT JOIN departamentos d \n    ON e.departamento_id = d.id;\n'''\npd.read_sql_query(query, conn)","key":"hPniob6sl5"},{"type":"outputs","id":"ocTUl-KRJe-stmpBFVAEt","children":[],"key":"kyAENURExe"}],"identifier":"38f8aa2d","html_id":"38f8aa2d","key":"E0MZBVzuD8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"14. RIGHT JOIN y FULL JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RjFxEYqRTN"}],"identifier":"id-14-right-join-y-full-join","label":"14. RIGHT JOIN y FULL JOIN","html_id":"id-14-right-join-y-full-join","implicit":true,"key":"BJmGfKB1Zq"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Nota: SQLite no soporta directamente RIGHT JOIN ni FULL OUTER JOIN, pero se pueden emular con UNION o invirtiendo las tablas en un LEFT JOIN.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"MhpZ12yhmR"}],"key":"cPU8CJOzxQ"}],"identifier":"66da9f5f","html_id":"66da9f5f","key":"RSnoYTZF2p"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Emulando RIGHT JOIN invirtiendo la lógica con LEFT JOIN\nquery = '''\nSELECT \n    e.nombre AS empleado,\n    d.nombre AS departamento\nFROM departamentos d\nLEFT JOIN empleados e \n    ON e.departamento_id = d.id;\n'''\npd.read_sql_query(query, conn)","key":"xDcEX6TCFO"},{"type":"outputs","id":"fuiOv_JETO_1bu4jwhMcW","children":[],"key":"yHlmmzK7wW"}],"identifier":"89d4ff99","html_id":"89d4ff99","key":"qTxi7f6jxb"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"15. SELF JOIN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XgH3WxDiPG"}],"identifier":"id-15-self-join","label":"15. SELF JOIN","html_id":"id-15-self-join","implicit":true,"key":"hFSAX0HljQ"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Es una unión regular donde una tabla se une a sí misma.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"t0ctDE6yBX"}],"key":"MuELrLt4Dw"}],"identifier":"4e904b88","html_id":"4e904b88","key":"TFUeBmhT3n"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Ejemplo teórico creando una relación de compañeros en el mismo departamento\nquery = '''\nSELECT \n    e1.nombre AS empleado1,\n    e2.nombre AS empleado2,\n    e1.departamento_id\nFROM empleados e1\nJOIN empleados e2 \n    ON e1.departamento_id = e2.departamento_id \n    AND e1.id < e2.id;\n'''\npd.read_sql_query(query, conn)","key":"pgeROvBnvR"},{"type":"outputs","id":"JEia5D0bOp51IV4EJuII1","children":[],"key":"WLtaRcnv05"}],"identifier":"81046ca6","html_id":"81046ca6","key":"a71470GJMx"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"16. Subconsultas (Subqueries)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TbtW5ZnEXb"}],"identifier":"id-16-subconsultas-subqueries","label":"16. Subconsultas (Subqueries)","html_id":"id-16-subconsultas-subqueries","implicit":true,"key":"MkJWfvtTMC"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Una consulta dentro de otra consulta.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"FUuopq3K8P"}],"key":"VZPqYxwXk4"}],"identifier":"d85997b9","html_id":"d85997b9","key":"L3lxN44Zl2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nSELECT nombre, salario\nFROM empleados\nWHERE salario > (\n    SELECT AVG(salario) FROM empleados\n);\n'''\npd.read_sql_query(query, conn)","key":"yQmMPnLK03"},{"type":"outputs","id":"Gj2VjGQollfefm2qWLdPZ","children":[],"key":"Tc68oRqs2p"}],"identifier":"d60aedf6","html_id":"d60aedf6","key":"BhuCAVxCT1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"17. CTEs (Common Table Expressions)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lr4R8OjxMJ"}],"identifier":"id-17-ctes-common-table-expressions","label":"17. CTEs (Common Table Expressions)","html_id":"id-17-ctes-common-table-expressions","implicit":true,"key":"mx2J5xUMxP"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Las CTEs proporcionan un conjunto de resultados temporal con nombre que se puede referenciar dentro de una sentencia SELECT, INSERT, UPDATE o DELETE.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"FiH5WfjPWd"}],"key":"NVk8UAIz8s"}],"identifier":"8802a0c5","html_id":"8802a0c5","key":"C9q83UXoyw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"query = '''\nWITH PromedioSalarios AS (\n    SELECT departamento_id, AVG(salario) as promedio\n    FROM empleados\n    GROUP BY departamento_id\n)\nSELECT \n    e.nombre,\n    e.salario,\n    p.promedio\nFROM empleados e\nJOIN PromedioSalarios p \n    ON e.departamento_id = p.departamento_id\nWHERE e.salario > p.promedio;\n'''\npd.read_sql_query(query, conn)","key":"Mt0RPKeHAR"},{"type":"outputs","id":"TmLcbdJtzmbkcL7onU13E","children":[],"key":"UIZYEpVlub"}],"identifier":"f595c74d","html_id":"f595c74d","key":"VffKzZ0ZCr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Cerrar la conexión\nconn.close()","key":"LwSZsXoRsh"},{"type":"outputs","id":"uzeoqatOLh-l80V-kXeql","children":[],"key":"Hf15nHJUCx"}],"identifier":"fb5aee38","html_id":"fb5aee38","key":"QNXvg7ciBF"}],"key":"mu6ong2wAK"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Introducción a SQL","url":"/sql-basico","group":"Módulo 1 - FUNDAMENTOS"},"next":{"title":"SQL Avanzado: Análisis de Datos y Window Functions","url":"/sql-avanzado","group":"Módulo 1 - FUNDAMENTOS"}}},"domain":"http://pre.render"}